# Deterministic line endings across Windows/Linux checkouts (P0.5).
# Text files normalize to LF in the repository; binary types are protected.
* text=auto eol=lf

# Windows scripts keep CRLF where the platform requires it
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.docx binary
*.pptx binary
*.xlsx binary
*.pdf binary
*.zip binary
*.gz binary
*.mp4 binary
*.webm binary
*.wav binary
*.mp3 binary
