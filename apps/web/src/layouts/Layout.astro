---
// Layout.astro — Document shell and server-rendered Site Chrome (Tasks D1a, D1b, VC-D/E).
import Header from '../components/chrome/Header.astro';
import Drawer from '../components/chrome/Drawer.astro';
import SearchOverlay from '../components/chrome/SearchOverlay.astro';
import Breadcrumb from '../components/chrome/Breadcrumb.astro';
import Footer from '../components/chrome/Footer.astro';
import CookieBanner from '../components/chrome/CookieBanner.astro';
import CompareTray from '../components/chrome/CompareTray.astro';
import { getDeliverySettings, getDeliveryNavMenu } from '../lib/delivery';
import { SETTINGS_GROUP_DEFAULTS, resolveComputedFigures } from '@twinmos/shared';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  desc: string;
  bodyClass?: string;
  noindex?: boolean;
  locale?: string;
  hreflangGrid?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  renderChrome?: boolean;
  ogImage?: string;
  preloadImage?: string;
}

const {
  title,
  desc,
  bodyClass = '',
  noindex = false,
  locale = 'en',
  hreflangGrid = false,
  breadcrumbs = [],
  renderChrome = true,
  ogImage: customOgImage,
  preloadImage,
} = Astro.props;

const path = Astro.url.pathname === '/index.html' ? '/' : Astro.url.pathname;
const canonical = new URL(path, Astro.site || 'https://www.twinmos.com');

const LOCALES = ['en', 'ar', 'hi', 'ru', 'zh-cn', 'fr', 'es', 'pt', 'de'];
const RTL = ['ar'];
const dir = RTL.includes(locale) ? 'rtl' : undefined;

const localeUrl = (code: string) => {
  const origin = Astro.site || 'https://www.twinmos.com';
  if (hreflangGrid) return new URL(code === 'en' ? '/' : `/${code}`, origin);
  // An English page is its own alternate; a localised page alternates to the
  // locale-stripped English path and to the same path under each locale.
  if (locale === 'en') return new URL(path, origin);
  const rest = path.replace(new RegExp(`^/${locale}(?=/|$)`), '') || '/';
  return new URL(
    code === 'en' ? rest : `/${code}${rest === '/' ? '' : rest}`,
    origin,
  );
};

const [settings, headerMenu, drawerMenu, footerMenu] = await Promise.all([
  getDeliverySettings(),
  getDeliveryNavMenu('header', locale),
  getDeliveryNavMenu('drawer', locale),
  getDeliveryNavMenu('footer', locale),
]);
const brand = { ...SETTINGS_GROUP_DEFAULTS['site.brand'], ...(settings['site.brand'] || {}) };
const contact = { ...SETTINGS_GROUP_DEFAULTS['site.contact'], ...(settings['site.contact'] || {}) };
const social = { ...SETTINGS_GROUP_DEFAULTS['site.social'], ...(settings['site.social'] || {}) };
const figures = resolveComputedFigures({ ...SETTINGS_GROUP_DEFAULTS['site.figures'], ...(settings['site.figures'] || {}) });
const seo = { ...SETTINGS_GROUP_DEFAULTS['seo.defaults'], ...(settings['seo.defaults'] || {}) };
const integrations = { ...SETTINGS_GROUP_DEFAULTS['integrations'], ...(settings['integrations'] || {}) };
const cookieSettings = { ...SETTINGS_GROUP_DEFAULTS['site.cookie'], ...(settings['site.cookie'] || {}) };
const whatsapp = { ...SETTINGS_GROUP_DEFAULTS['site.whatsapp'], ...(settings['site.whatsapp'] || {}) };

const pageTitle = applyLiveFigures(title || seo.defaultTitle);
const pageDesc = applyLiveFigures(desc || seo.defaultDescription);

// Copy authored against the original baseline ("since 1998", "93+ countries")
// follows site.figures when the operator changes it. Other years (e.g. the
// ISO 9001 "since 2002" certification) are deliberately left untouched.
function applyLiveFigures(text: string): string {
  return String(text)
    .replace(/\b(since|founded)\s+1998\b/gi, (_m, word) => `${word} ${figures.foundingYear}`)
    .replace(/\b93\+\s+countries\b/gi, `${figures.countriesCount} countries`);
}
const siteOrigin = Astro.site || 'https://www.twinmos.com';
const ogImage = customOgImage
  ? (customOgImage.startsWith('http') ? customOgImage : new URL(customOgImage, siteOrigin).toString())
  : new URL(seo.defaultOgImage || '/assets/img/og-cover.png', siteOrigin).toString();

const socialUrls = [
  social.facebook,
  social.instagram,
  social.linkedin,
  social.x,
  social.youtube,
  social.pinterest,
].filter(Boolean);

const ORG_LD = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: brand.name,
  url: 'https://www.twinmos.com/',
  logo: new URL(brand.logoUrl || '/assets/img/logo.webp', siteOrigin).toString(),
  foundingDate: String(figures.foundingYear || brand.foundingYear || 1998),
  email: contact.email,
  telephone: contact.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.address,
    addressLocality: 'Taipei',
    addressCountry: contact.country || 'TW',
  },
  sameAs: socialUrls,
});

const SITE_LD = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: brand.name,
  url: 'https://www.twinmos.com/',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://www.twinmos.com/search?q={q}',
    'query-input': 'required name=q',
  },
});
const BREADCRUMB_LD = breadcrumbs && breadcrumbs.length > 0 ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b: { label: string; href?: string }, idx: number) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: b.label,
    item: b.href ? new URL(b.href, Astro.site || 'https://www.twinmos.com').toString() : undefined,
  })),
}) : null;

const OG_IMAGE = ogImage;
const OG_TYPE = path === '/' ? 'website' : 'article';
---
<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#0A2540" />
    <meta name="description" content={pageDesc} />
    {noindex ? <meta name="robots" content="noindex,nofollow" /> : <meta name="robots" content={seo.defaultRobots} />}
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    {hreflangGrid ? (
      LOCALES.map((code) => <link rel="alternate" hreflang={code} href={localeUrl(code)} />)
    ) : (
      <link rel="alternate" hreflang={locale} href={canonical} />
    )}
    <link rel="alternate" hreflang="x-default" href={localeUrl('en')} />

    <!-- Open Graph (Task E1 / SEO-01) -->
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:type" content={OG_TYPE} />
    <meta property="og:image" content={OG_IMAGE} />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <link rel="icon" href={brand.faviconUrl || '/favicon.ico'} />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="stylesheet" href="/assets/css/main.css" />
    <link rel="stylesheet" href="/assets/css/a11y-overrides.css" />
    {locale !== 'en' && <link rel="stylesheet" href="/assets/css/rtl.css" />}
    <meta name="twinmos-api" content={import.meta.env.PUBLIC_API_URL ?? ''} />
    <meta name="turnstile-site-key" content={integrations.turnstileSiteKey || import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || ''} />
    <meta
      name="twinmos-analytics"
      content={integrations.analyticsEnabled && integrations.googleAnalyticsId ? integrations.googleAnalyticsId : ''}
    />

    <script type="application/ld+json" set:html={ORG_LD} />
    <script type="application/ld+json" set:html={SITE_LD} />
    {BREADCRUMB_LD && <script type="application/ld+json" set:html={BREADCRUMB_LD} />}
  </head>
  <body class={bodyClass}>
    {renderChrome && (
      <>
        <a class="skip-link" href="#main">Skip to main content</a>
        <Header activePath={path} currentLocale={locale} brand={brand} figures={figures} menu={headerMenu} />
        <Drawer currentLocale={locale} brand={brand} menu={drawerMenu} />
        <SearchOverlay />
        {breadcrumbs.length > 0 && <Breadcrumb items={breadcrumbs} />}
      </>
    )}

    <slot />

    {renderChrome && (
      <>
        <Footer brand={brand} contact={contact} social={social} figures={figures} whatsapp={whatsapp} menu={footerMenu} />
        <CookieBanner settings={cookieSettings} />
        <CompareTray />
      </>
    )}

    <!-- App layer boots post-first-paint via layout-init.js (eliminates unsafe-inline in script-src) -->
    <script is:inline src="/assets/js/widgets-config.js"></script>
    <script is:inline src="/assets/js/widgets-init.js"></script>
    <script is:inline src="/assets/js/layout-init.js"></script>
    <script is:inline src="/assets/js/analytics-init.js"></script>
  </body>
</html>
