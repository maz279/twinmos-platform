---
// Layout.astro — Document shell and server-rendered Site Chrome (Tasks D1a, D1b, VC-D/E).
import Header from '../components/chrome/Header.astro';
import Drawer from '../components/chrome/Drawer.astro';
import SearchOverlay from '../components/chrome/SearchOverlay.astro';
import Breadcrumb from '../components/chrome/Breadcrumb.astro';
import Footer from '../components/chrome/Footer.astro';
import CookieBanner from '../components/chrome/CookieBanner.astro';
import CompareTray from '../components/chrome/CompareTray.astro';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  desc: string;
  bodyClass?: string;
  noindex?: boolean;
  locale?: string;
  hreflangGrid?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  renderChrome?: boolean;
}

const {
  title,
  desc,
  bodyClass = '',
  noindex = false,
  locale = 'en',
  hreflangGrid = false,
  breadcrumbs = [],
  renderChrome = true,
} = Astro.props;

const path = Astro.url.pathname === '/index.html' ? '/' : Astro.url.pathname;
const canonical = new URL(path, Astro.site || 'https://www.twinmos.com');

const LOCALES = ['en', 'ar', 'hi', 'ru', 'zh-cn', 'fr', 'es', 'pt', 'de'];
const RTL = ['ar'];
const dir = RTL.includes(locale) ? 'rtl' : undefined;

const localeUrl = (code: string) =>
  code === 'en'
    ? new URL(hreflangGrid ? '/' : (path === '/' ? '/' : path), Astro.site || 'https://www.twinmos.com')
    : new URL(`/${code}.html`, Astro.site || 'https://www.twinmos.com');

const ORG_LD = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'TwinMOS Technologies',
  url: 'https://www.twinmos.com/',
  logo: 'https://www.twinmos.com/assets/img/logo.webp',
  foundingDate: '1998',
  address: { '@type': 'PostalAddress', addressLocality: 'Taipei', addressCountry: 'TW' },
  sameAs: [
    'https://www.facebook.com/twinmos.tech',
    'https://www.instagram.com/twinmos.tech',
    'https://www.linkedin.com/company/twinmos-technologies',
    'https://x.com/twinmos',
    'https://www.youtube.com/c/TwinMOStech',
    'https://www.pinterest.com/twinmos',
  ],
});

const SITE_LD = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'TwinMOS',
  url: 'https://www.twinmos.com/',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://www.twinmos.com/search.html?q={q}',
    'query-input': 'required name=q',
  },
});
const BREADCRUMB_LD = breadcrumbs && breadcrumbs.length > 0 ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b: { label: string; href?: string }, idx: number) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: b.label,
    item: b.href ? new URL(b.href, Astro.site || 'https://www.twinmos.com').toString() : undefined,
  })),
}) : null;

const OG_IMAGE = 'https://www.twinmos.com/assets/img/og-cover.png';
const OG_TYPE = path === '/' ? 'website' : 'article';
---
<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#0A2540" />
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {hreflangGrid ? (
      LOCALES.map((code) => <link rel="alternate" hreflang={code} href={localeUrl(code)} />)
    ) : (
      <link rel="alternate" hreflang={locale} href={canonical} />
    )}
    <link rel="alternate" hreflang="x-default" href={localeUrl('en')} />

    <!-- Open Graph (Task E1 / SEO-01) -->
    <meta property="og:site_name" content="TwinMOS Technologies" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:type" content={OG_TYPE} />
    <meta property="og:image" content={OG_IMAGE} />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <link rel="icon" type="image/png" href="assets/img/favicon.png" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="stylesheet" href="assets/css/main.css" />
    <link rel="stylesheet" href="assets/css/a11y-overrides.css" />
    {locale !== 'en' && <link rel="stylesheet" href="assets/css/rtl.css" />}
    <meta name="twinmos-api" content={import.meta.env.PUBLIC_API_URL ?? ''} />
    <meta name="turnstile-site-key" content={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? ''} />
    <script is:inline define:vars={{ turnstileSiteKey: import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '' }}>
      window.TURNSTILE_SITE_KEY = turnstileSiteKey;
    </script>
    <script type="application/ld+json" set:html={ORG_LD} />
    <script type="application/ld+json" set:html={SITE_LD} />
    {BREADCRUMB_LD && <script type="application/ld+json" set:html={BREADCRUMB_LD} />}
  </head>
  <body class={bodyClass}>
    {renderChrome && (
      <>
        <a class="skip-link" href="#main">Skip to main content</a>
        <Header activePath={path} currentLocale={locale} />
        <Drawer currentLocale={locale} />
        <SearchOverlay />
        {breadcrumbs.length > 0 && <Breadcrumb items={breadcrumbs} />}
      </>
    )}

    <slot />

    {renderChrome && (
      <>
        <Footer />
        <CookieBanner />
        <CompareTray />
      </>
    )}

    <!-- App layer boots post-first-paint via layout-init.js (eliminates unsafe-inline in script-src) -->
    <script is:inline src="assets/js/layout-init.js"></script>
  </body>
</html>
