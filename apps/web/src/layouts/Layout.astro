---
// P1 layout — owns the document shell (head + body wrapper + runtime scripts).
// Page bodies are ported verbatim from the audited prototype (see tooling/port_pages.py)
// so visual parity holds by construction. Chrome componentization lands with islands (P2+).
interface Props {
  title: string;
  desc: string;
  bodyClass?: string;
  noindex?: boolean;
  /** P4: locale of THIS page (affects lang/dir + which hreflang is canonical). */
  locale?: string;
  /** P4: when true, emit the full 9-locale hreflang grid (locale landings only). */
  hreflangGrid?: boolean;
}
const { title, desc, bodyClass = '', noindex = false, locale = 'en', hreflangGrid = false } = Astro.props;
/* Homepage canonical is the site root (not /index.html) to avoid signal
 * fragmentation; other pages keep their .html path (build.format = 'file'). */
const path = Astro.url.pathname === '/index.html' ? '/' : Astro.url.pathname;
const canonical = new URL(path, Astro.site);

/* P4: hreflang — 9-locale grid for locale landings; plain en/x-default on EN.
 * build.format:'file' emits landings as /{code}.html (consistent with the
 * whole site's /page.html URL scheme). */
const LOCALES = ['en', 'ar', 'hi', 'ru', 'zh-cn', 'fr', 'es', 'pt', 'de'];
const RTL = ['ar'];
// dir is emitted ONLY for RTL — the prototype ships LTR pages with no dir
// attribute, and an explicit dir="ltr" measurably shifts Chrome's text
// layout (parity @390 dropped ~4pp on every text line until this matched).
const dir = RTL.includes(locale) ? 'rtl' : undefined;
const localeUrl = (code: string) =>
  code === 'en'
    ? new URL(hreflangGrid ? '/' : (path === '/' ? '/' : path), Astro.site) // landings mirror the homepage
    : new URL(`/${code}.html`, Astro.site);

const ORG_LD = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'TwinMOS Technologies',
  url: 'https://www.twinmos.com/',
  logo: 'https://www.twinmos.com/assets/img/logo.webp',
  foundingDate: '1998',
  address: { '@type': 'PostalAddress', addressLocality: 'Taipei', addressCountry: 'TW' },
  sameAs: [
    'https://www.facebook.com/twinmos.tech',
    'https://www.instagram.com/twinmos.tech',
    'https://www.linkedin.com/company/twinmos-technologies',
    'https://x.com/twinmos',
    'https://www.youtube.com/c/TwinMOStech',
    'https://www.pinterest.com/twinmos',
  ],
});
const SITE_LD = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'TwinMOS',
  url: 'https://www.twinmos.com/',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://www.twinmos.com/search.html?q={q}',
    'query-input': 'required name=q',
  },
});
---
<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#0A2540" />
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {hreflangGrid ? (
      LOCALES.map((code) => <link rel="alternate" hreflang={code} href={localeUrl(code)} />)
    ) : (
      <link rel="alternate" hreflang={locale} href={canonical} />
    )}
    <link rel="alternate" hreflang="x-default" href={localeUrl('en')} />
    <link rel="icon" type="image/png" href="assets/img/favicon.png" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="stylesheet" href="assets/css/main.css" />
    <link rel="stylesheet" href="assets/css/a11y-overrides.css" />
    {locale !== 'en' && <link rel="stylesheet" href="assets/css/rtl.css" />}
    <meta name="twinmos-api" content={import.meta.env.PUBLIC_API_URL ?? ''} />
    <meta name="turnstile-site-key" content={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? ''} />
    <script type="application/ld+json" set:html={ORG_LD} />
    <script type="application/ld+json" set:html={SITE_LD} />
  </head>
  <body class={bodyClass}>
    <slot />
    <!-- App layer boots post-first-paint via layout-init.js (eliminates unsafe-inline in script-src) -->
    <script is:inline src="assets/js/layout-init.js"></script>
  </body>
</html>

