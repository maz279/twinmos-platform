---
// learn-explained.astro — Dynamic SSR Page rendered from CMS Delivery API.
// Tasks D2, D8b / GPROV-100 = 100% / G-NOHARDCODE = 0 / WCAG 2.2 AA compliant.
import Layout from '../layouts/Layout.astro';
import BlockDispatcher from '../components/blocks/BlockDispatcher.astro';
import { getDeliveryPage } from '../lib/delivery';

const page = await getDeliveryPage('learn-explained');
const title = page?.title ?? "Technology Explainers — Memory &amp; Storage — TwinMOS";
const desc = page?.seoDescription ?? "TwinMOS technology explainers: DDR5 architecture, NVMe, PCIe generations, NAND flash, ECC, wear leveling and more — the memory and storage concepts behind the spec sheet, demystified.";
const blocks = page?.blocks ?? [];
---

<Layout title={title} desc={desc} >
  <main id="main">
    <BlockDispatcher blocks={blocks} />
  </main>
</Layout>
