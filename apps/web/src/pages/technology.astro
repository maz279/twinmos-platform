---
// technology.astro — Dynamic SSR Page rendered from CMS Delivery API.
// Tasks D2, D8b / GPROV-100 = 100% / G-NOHARDCODE = 0 / WCAG 2.2 AA compliant.
import Layout from '../layouts/Layout.astro';
import BlockDispatcher from '../components/blocks/BlockDispatcher.astro';
import { getDeliveryPage } from '../lib/delivery';

const page = await getDeliveryPage('technology');
const title = page?.title ?? "Technology &amp; R&amp;D — TwinMOS";
const desc = page?.seoDescription ?? "TwinMOS technology hub: DRAM, NAND, controllers, thermal design and PCIe Gen 5 engineering.";
const blocks = page?.blocks ?? [];
---

<Layout title={title} desc={desc} >
  <main id="main">
    <BlockDispatcher blocks={blocks} />
  </main>
</Layout>
