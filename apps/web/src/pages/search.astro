---
// search.astro — Server-rendered Search Results Page with Facets.
// Tasks D7b / SEARCH-01 / Reflected Query Escaped / noindex compliant.
import Layout from '../layouts/Layout.astro';
import BlockDispatcher from '../components/blocks/BlockDispatcher.astro';
import { getDeliveryPage } from '../lib/delivery';

const rawQuery = Astro.url.searchParams.get('q') || '';
// Strict escaping of reflected query to satisfy security and ZAP checks
const safeQuery = rawQuery
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/>/g, '&gt;')
  .replace(/"/g, '&quot;')
  .replace(/'/g, '&#39;');

const page = await getDeliveryPage('search');
const title = safeQuery ? `Search: ${safeQuery} — TwinMOS` : (page?.title ?? "Search — TwinMOS");
const desc = page?.seoDescription ?? "Search TwinMOS products and articles.";
const blocks = page?.blocks ?? [];
---

<Layout title={title} desc={desc} noindex={true}>
  <main id="main">
    {blocks.length > 0 ? (
      <BlockDispatcher blocks={blocks} />
    ) : (
      <>
        <div class="page-hero">
          <div class="wrap">
            <span class="eyebrow">Search</span>
            <h1 class="h1">Results for "<span id="searchQ">{safeQuery}</span>"</h1>
            <p class="lede">Searching all catalog products and the media &amp; articles library.</p>
          </div>
        </div>
        <section style="padding-top:clamp(22px,3vw,36px)">
          <div class="wrap" id="searchMount"></div>
        </section>
      </>
    )}
  </main>
</Layout>
