---
// /newsletter — landing page for the links in newsletter e-mails (the API
// redirects here after confirm/unsubscribe instead of showing raw JSON, ZT-033).
import Layout from '../layouts/Layout.astro';

const status = Astro.url.searchParams.get('status');
const MESSAGES: Record<string, { title: string; body: string }> = {
  confirmed: { title: 'Subscription confirmed', body: 'Thank you — you will receive TwinMOS product news. Every e-mail carries a one-click unsubscribe link.' },
  unsubscribed: { title: 'You have been unsubscribed', body: 'You will no longer receive the TwinMOS newsletter. You can subscribe again from the footer of any page.' },
  invalid: { title: 'This link is no longer valid', body: 'Confirmation links expire after 7 days and can be used once. Subscribe again from the footer of any page to get a new link.' },
};
const msg = MESSAGES[status ?? ''] ?? { title: 'TwinMOS newsletter', body: 'Subscribe from the footer of any page to receive product news.' };
Astro.response.headers.set('Cache-Control', 'no-store');
---

<Layout title={`${msg.title} — TwinMOS`} desc="TwinMOS newsletter subscription status." noindex={true}>
  <main id="main">
    <div class="page-hero">
      <div class="wrap">
        <span class="eyebrow">Newsletter</span>
        <h1 class="h1">{msg.title}</h1>
        <p class="lede">{msg.body}</p>
        <p style="margin-top:18px"><a class="btn btn-primary" href="/">Back to the home page</a></p>
      </div>
    </div>
  </main>
</Layout>
