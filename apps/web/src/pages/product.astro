---
// product.astro — Legacy Product Route Redirector (ADR D-5, Task T3.2.2)
// Clean URLs canonically live at /products/<slug>.
const slug = Astro.url.searchParams.get('id') || Astro.url.searchParams.get('slug');
const target = slug ? `/products/${encodeURIComponent(slug)}` : '/shop';
return Astro.redirect(target, 301);
