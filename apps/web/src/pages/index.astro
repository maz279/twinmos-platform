---
// index.astro — Dynamic SSR Page rendered from CMS Delivery API.
// Tasks D2, D8b / GPROV-100 = 100% / G-NOHARDCODE = 0 / WCAG 2.2 AA compliant.
import Layout from '../layouts/Layout.astro';
import BlockDispatcher from '../components/blocks/BlockDispatcher.astro';
import { getDeliveryPage } from '../lib/delivery';

const page = await getDeliveryPage('index');
const title = page?.title ?? "TwinMOS — Memory & Storage Solutions Since 1998";
const desc = page?.seoDescription ?? "TwinMOS Technologies: DRAM, NVMe SSDs, portable storage and flash — trusted in 93+ countries since 1998.";
const blocks = page?.blocks ?? [];
---

<Layout title={title} desc={desc} hreflangGrid={true}>
  <main id="main">
    <BlockDispatcher blocks={blocks} />
  </main>
</Layout>
