---
// 410.astro — Dynamic SSR Error Page rendered from CMS Delivery API.
// Tasks D2, D8b, T5.2.2 / GPROV-100 / WCAG 2.2 AA compliant.
import Layout from '../layouts/Layout.astro';
import BlockDispatcher from '../components/blocks/BlockDispatcher.astro';
import { getDeliveryPage } from '../lib/delivery';

Astro.response.status = 410;

const page = await getDeliveryPage('410');
const title = page?.title ?? "Resource Gone — TwinMOS";
const desc = page?.seoDescription ?? "410 — resource permanently removed.";
const blocks = page?.blocks ?? [];
const hasCmsBlocks = Array.isArray(blocks) && blocks.length > 0;

if (page?.cacheTags && Array.isArray(page.cacheTags)) {
  const tags = page.cacheTags.join(', ');
  Astro.response.headers.set('Cache-Tag', tags);
  Astro.response.headers.set('X-Cache-Tags', tags);
}
---

<Layout title={title} desc={desc} noindex={true}>
  <main id="main">
    {hasCmsBlocks ? (
      <BlockDispatcher blocks={blocks} />
    ) : (
      <section class="page-hero block-hero" style="min-height:55vh;display:flex;align-items:center;text-align:center" data-fallback="offline-410">
        <div class="wrap" style="max-width:680px;margin:0 auto">
          <span class="eyebrow" style="color:var(--accent,#E02B20);font-weight:700">410 Gone</span>
          <h1 class="h1" style="margin:12px 0 16px">This resource is no longer available</h1>
          <p class="lede" style="margin-bottom:28px">This product, specification, or document has reached end-of-life and has been permanently removed from our active catalog.</p>
          <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
            <a class="btn btn-accent" href="/shop">View active catalog</a>
            <a class="btn btn-ghost" href="/legal#eol">EOL Product List</a>
            <a class="btn btn-ghost" href="/support">Contact support</a>
          </div>
        </div>
      </section>
    )}
  </main>
</Layout>
