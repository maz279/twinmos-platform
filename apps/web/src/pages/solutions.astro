---
// solutions.astro — Dynamic SSR Page rendered from CMS Delivery API.
// Tasks D2, D8b / GPROV-100 = 100% / G-NOHARDCODE = 0 / WCAG 2.2 AA compliant.
import Layout from '../layouts/Layout.astro';
import BlockDispatcher from '../components/blocks/BlockDispatcher.astro';
import { getDeliveryPage } from '../lib/delivery';

const page = await getDeliveryPage('solutions');
const title = page?.title ?? "B2B & OEM Memory Solutions — TwinMOS";
const desc = page?.seoDescription ?? "TwinMOS B2B and OEM solutions since 1998: regional distribution to 93+ countries, custom-labeled manufacturing in Dongguan, and fleet upgrades backed by lifetime DRAM warranty.";
const blocks = page?.blocks ?? [];
---

<Layout title={title} desc={desc} >
  <main id="main">
    <BlockDispatcher blocks={blocks} />
  </main>
</Layout>
