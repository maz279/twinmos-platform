---
// learn.astro — Dynamic SSR Page rendered from CMS Delivery API.
// Tasks D2, D8b / GPROV-100 = 100% / G-NOHARDCODE = 0 / WCAG 2.2 AA compliant.
import Layout from '../layouts/Layout.astro';
import BlockDispatcher from '../components/blocks/BlockDispatcher.astro';
import { getDeliveryPage } from '../lib/delivery';

const page = await getDeliveryPage('learn');
const title = page?.title ?? "Knowledge Hub — Learn Memory &amp; Storage — TwinMOS";
const desc = page?.seoDescription ?? "TwinMOS Knowledge Hub: 54 buying guides, DDR5/NVMe technology explainers, benchmarks, an A–Z glossary and learning paths — written by the memory engineering team.";
const blocks = page?.blocks ?? [];
---

<Layout title={title} desc={desc} >
  <main id="main">
    <BlockDispatcher blocks={blocks} />
  </main>
</Layout>
