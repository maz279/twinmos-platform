---
// gaming.astro — Dynamic SSR Page rendered from CMS Delivery API.
// Tasks D2, D8b / GPROV-100 = 100% / G-NOHARDCODE = 0 / WCAG 2.2 AA compliant.
import Layout from '../layouts/Layout.astro';
import BlockDispatcher from '../components/blocks/BlockDispatcher.astro';
import { getDeliveryPage } from '../lib/delivery';

const page = await getDeliveryPage('gaming');
const title = page?.title ?? "VOLTX Gaming Hub — TwinMOS";
const desc = page?.seoDescription ?? "TwinMOS VOLTX gaming memory: DDR5, RGB, lifetime warranty — plus Gen 5 storage for DirectStorage gaming.";
const blocks = page?.blocks ?? [];
---

<Layout title={title} desc={desc} bodyClass="gaming">
  <main id="main">
    <div id="arsenal" class="sr-only" aria-hidden="true"></div>
    <div id="tuning" class="sr-only" aria-hidden="true"></div>
    <div id="sync" class="sr-only" aria-hidden="true"></div>
    <div id="builds" class="sr-only" aria-hidden="true"></div>
    <div id="downloads" class="sr-only" aria-hidden="true"></div>
    <div id="stories" class="sr-only" aria-hidden="true"></div>
    <BlockDispatcher blocks={blocks} />
  </main>
</Layout>
