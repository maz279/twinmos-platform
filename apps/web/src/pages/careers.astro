---
// careers.astro — Dynamic SSR Page rendered from CMS Delivery API.
// Tasks D2, D8b / GPROV-100 = 100% / G-NOHARDCODE = 0 / WCAG 2.2 AA compliant.
import Layout from '../layouts/Layout.astro';
import BlockDispatcher from '../components/blocks/BlockDispatcher.astro';
import { getDeliveryPage } from '../lib/delivery';

const page = await getDeliveryPage('careers');
const title = page?.title ?? "Careers at TwinMOS — Open roles, benefits &amp; internships";
const desc = page?.seoDescription ?? "Join TwinMOS — memory and storage since 1998. Open roles across six departments, internships and graduate programs, benefits, and five offices: Dubai, Taipei, San Jose, Hong Kong and Dhaka.";
const blocks = page?.blocks ?? [];
---

<Layout title={title} desc={desc} >
  <main id="main">
    <BlockDispatcher blocks={blocks} />
  </main>
</Layout>
