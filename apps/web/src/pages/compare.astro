---
// compare.astro — Dynamic SSR Page rendered from CMS Delivery API.
// Tasks D2, D8b / GPROV-100 = 100% / G-NOHARDCODE = 0 / WCAG 2.2 AA compliant.
import Layout from '../layouts/Layout.astro';
import BlockDispatcher from '../components/blocks/BlockDispatcher.astro';
import { getDeliveryPage } from '../lib/delivery';

const page = await getDeliveryPage('compare');
const title = page?.title ?? "Compare Products — TwinMOS";
const desc = page?.seoDescription ?? "Side-by-side TwinMOS product comparison with automatic difference highlighting.";
const blocks = page?.blocks ?? [];
---

<Layout title={title} desc={desc}>
  <main id="main">
    {blocks.length > 0 ? (
      <BlockDispatcher blocks={blocks} />
    ) : (
      <>
        <div class="page-hero">
          <div class="wrap">
            <span class="eyebrow">Decision tool</span>
            <h1 class="h1">Compare products</h1>
            <p class="lede">Add up to four products from the catalog using the ⇄ button on any product card. Differences are highlighted automatically, and your tray persists between visits.</p>
          </div>
        </div>
        <section style="padding-top:clamp(22px,3vw,36px)">
          <div class="wrap" id="cmpMount"></div>
        </section>
      </>
    )}
  </main>
</Layout>
