---
// learn-guides.astro — Dynamic SSR Page rendered from CMS Delivery API.
// Tasks D2, D8b / GPROV-100 = 100% / G-NOHARDCODE = 0 / WCAG 2.2 AA compliant.
import Layout from '../layouts/Layout.astro';
import BlockDispatcher from '../components/blocks/BlockDispatcher.astro';
import { getDeliveryPage } from '../lib/delivery';

const page = await getDeliveryPage('learn-guides');
const title = page?.title ?? "Buying Guides — Memory & Storage — TwinMOS";
const desc = page?.seoDescription ?? "TwinMOS buying guides: how to choose RAM and SSDs for gaming, laptops, creator workstations, PC builds and enterprise fleets — with best-for guidance for every use case.";
const blocks = page?.blocks ?? [];
---

<Layout title={title} desc={desc} >
  <main id="main">
    <BlockDispatcher blocks={blocks} />
  </main>
</Layout>
