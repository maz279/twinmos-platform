---
// learn-blog.astro — Dynamic SSR Page rendered from CMS Delivery API.
// Tasks D2, D8b / GPROV-100 = 100% / G-NOHARDCODE = 0 / WCAG 2.2 AA compliant.
import Layout from '../layouts/Layout.astro';
import BlockDispatcher from '../components/blocks/BlockDispatcher.astro';
import { getDeliveryPage } from '../lib/delivery';

const page = await getDeliveryPage('learn-blog');
const title = page?.title ?? "Tech Insights & Blog — TwinMOS";
const desc = page?.seoDescription ?? "TwinMOS tech insights: product launch deep-dives, COMPUTEX event coverage and engineering commentary on memory and storage trends.";
const blocks = page?.blocks ?? [];
---

<Layout title={title} desc={desc} >
  <main id="main">
    <BlockDispatcher blocks={blocks} />
  </main>
</Layout>
