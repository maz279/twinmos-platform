---
// learn-benchmarks.astro — Dynamic SSR Page rendered from CMS Delivery API.
// Tasks D2, D8b / GPROV-100 = 100% / G-NOHARDCODE = 0 / WCAG 2.2 AA compliant.
import Layout from '../layouts/Layout.astro';
import BlockDispatcher from '../components/blocks/BlockDispatcher.astro';
import { getDeliveryPage } from '../lib/delivery';

const page = await getDeliveryPage('learn-benchmarks');
const title = page?.title ?? "Benchmarks — Real-World Performance — TwinMOS";
const desc = page?.seoDescription ?? "TwinMOS benchmark library: CoreX Pro Gen5 and VOLTX DDR5 tested against competitors in gaming, content-creation and productivity workloads — with published methodology and test configurations.";
const blocks = page?.blocks ?? [];
---

<Layout title={title} desc={desc} >
  <main id="main">
    <BlockDispatcher blocks={blocks} />
  </main>
</Layout>
