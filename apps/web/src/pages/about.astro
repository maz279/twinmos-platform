---
// about.astro — Dynamic SSR Page rendered from CMS Delivery API.
// Tasks D2, D8b / GPROV-100 = 100% / G-NOHARDCODE = 0 / WCAG 2.2 AA compliant.
import Layout from '../layouts/Layout.astro';
import BlockDispatcher from '../components/blocks/BlockDispatcher.astro';
import { getDeliveryPage } from '../lib/delivery';

const preview = Astro.url.searchParams.get('preview') ?? undefined;
const page = await getDeliveryPage('about', 'en', preview);
if (preview) {
  Astro.response.headers.set('Cache-Control', 'private, no-store, must-revalidate');
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
}
const title = page?.title ?? "About TwinMOS — Since 1998";
const desc = page?.seoDescription ?? "TwinMOS Technologies: founded 1998 in Taipei; ISO 9001 quality system; offices in Dubai, Taipei, San Jose, Hong Kong and Dhaka; 93+ countries.";
const blocks = page?.blocks ?? [];
const noindex = Boolean(preview) || Boolean(page?.noindex);
---

<Layout title={title} desc={desc} noindex={noindex}>
  <main id="main">
    <BlockDispatcher blocks={blocks} />
  </main>
</Layout>
