---
// contact.astro — Dynamic SSR Page rendered from CMS Delivery API.
// Tasks D2, D8b / GPROV-100 = 100% / G-NOHARDCODE = 0 / WCAG 2.2 AA compliant.
import Layout from '../layouts/Layout.astro';
import BlockDispatcher from '../components/blocks/BlockDispatcher.astro';
import { getDeliveryPage } from '../lib/delivery';

const page = await getDeliveryPage('contact');
const title = page?.title ?? "Contact TwinMOS";
const desc = page?.seoDescription ?? "Contact TwinMOS: offices in Taipei, Dubai, Dongguan, Cologne and San Jose — sales@twinmos.com.";
const blocks = page?.blocks ?? [];
---

<Layout title={title} desc={desc} >
  <main id="main">
    <BlockDispatcher blocks={blocks} />
  </main>
</Layout>
