---
// news/[slug].astro — Dynamic SSR News & Event Showcase Reader (Tasks D4, T5.4.3 / Z-05)
// On-demand server-rendered from CMS Delivery API.
import Layout from '../../layouts/Layout.astro';
import BlockDispatcher from '../../components/blocks/BlockDispatcher.astro';
import ResponsiveImage from '../../components/common/ResponsiveImage.astro';
import { getDeliveryNewsPost, getDeliveryNews, getDeliveryPage } from '../../lib/delivery';
import { jsonForScript, sanitizeRichText } from '@twinmos/shared';

const { slug } = Astro.params;

// T3.2.2: The .html twin must not return 200
if (!slug || Astro.url.pathname.endsWith('.html')) {
  return new Response('Not Found', { status: 404, statusText: 'Not Found' });
}

const preview = Astro.url.searchParams.get('preview') ?? undefined;
const locale = 'en';
let newsItem = await getDeliveryNewsPost(slug, locale, preview);

// No fixture fallbacks: an unknown slug is a 404 (ZT-038).
if (!newsItem) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
} else {
  Astro.response.headers.set('Cache-Tag', `news, news-${slug}`);
  Astro.response.headers.set('X-Cache-Tags', `news, news-${slug}`);
}

const page = await getDeliveryPage('news');
const seoTitle = newsItem?.seo?.title || newsItem?.title;
const seoDesc = newsItem?.seo?.description || newsItem?.deck || newsItem?.title || page?.seoDescription || 'TwinMOS Newsroom & Event Showcases';
const heroImg = newsItem?.heroMedia?.key ? `/api/media/${newsItem.heroMedia.id}` : (newsItem?.seo?.ogImage || null);

const title = newsItem ? `${seoTitle} — TwinMOS Newsroom` : 'News Post Not Found — TwinMOS';
const desc = seoDesc;
const breadcrumbs = newsItem
  ? [
      { label: 'Home', href: '/' },
      { label: 'Newsroom', href: '/news' },
      { label: newsItem.title },
    ]
  : [
      { label: 'Home', href: '/' },
      { label: 'Newsroom', href: '/news' },
      { label: '404 Not Found' },
    ];

const postDate = newsItem?.eventDate ?? newsItem?.createdAt ?? null;
const formattedDate = postDate ? new Date(postDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : null;
const isEvent = newsItem?.tag === 'Events' || Boolean(newsItem?.eventDate);

// Estimate reading time
const wordCount = (newsItem?.body || '').replace(/<[^>]*>/g, '').split(/\s+/).length;
const readingTimeMin = Math.max(2, Math.ceil(wordCount / 180));

// Fetch related news on the server
let relatedNews: any[] = [];
if (newsItem) {
  const allNews = await getDeliveryNews(locale);
  relatedNews = allNews
    .filter((n: any) => n.slug !== newsItem.slug)
    .slice(0, 3)
    .map((n: any) => ({
      slug: n.slug,
      title: n.title,
      tag: n.tag || 'News',
      eventDate: n.eventDate,
      deck: n.deck || '',
    }));
}

const NEWS_LD = newsItem
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': isEvent ? 'Event' : 'NewsArticle',
      headline: newsItem.title,
      description: desc,
      image: heroImg ? [heroImg] : undefined,
      startDate: isEvent ? postDate : undefined,
      datePublished: postDate,
      author: {
        '@type': 'Organization',
        name: 'TwinMOS Technologies',
      },
      publisher: {
        '@type': 'Organization',
        name: 'TwinMOS Technologies',
        logo: {
          '@type': 'ImageObject',
          url: 'https://www.twinmos.com/assets/img/logo.svg',
        },
      },
    })
  : null;
---

<Layout title={title} desc={desc} breadcrumbs={breadcrumbs} noindex={!newsItem} ogImage={heroImg}>
  {NEWS_LD && <script type="application/ld+json" set:html={jsonForScript(NEWS_LD)} />}

  <main id="main">
    {newsItem ? (
      <article class="news-container wrap" style="padding: 48px 16px; max-width: 860px; margin: 0 auto;">
        <header class="news-header" style="margin-bottom: 36px; border-bottom: 1px solid #e2e8f0; padding-bottom: 24px;">
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
            {newsItem.tag && (
              <span class="badge" style="background: #2563eb; color: #fff; font-weight: 700; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 4px 10px; border-radius: 4px;">
                {newsItem.tag}
              </span>
            )}
            {isEvent && (
              <span class="badge" style="background: #0369a1; color: #fff; font-weight: 600; font-size: 0.75rem; text-transform: uppercase; padding: 4px 10px; border-radius: 4px;">
                Event
              </span>
            )}
          </div>
          <h1 class="h1 news-title" style="font-size: 2.5rem; margin-top: 8px; margin-bottom: 16px; line-height: 1.25; color: #0f172a;">
            {newsItem.title}
          </h1>
          <div class="news-meta" style="display: flex; flex-wrap: wrap; align-items: center; gap: 16px; color: #64748b; font-size: 0.9rem;">
            {formattedDate && <time datetime={postDate}>{formattedDate}</time>}
            <span>· {readingTimeMin} min read</span>
          </div>
          {heroImg && (
            <div class="news-hero-media" style="margin-top: 24px; border-radius: 8px; overflow: hidden;">
              <ResponsiveImage
                src={heroImg}
                alt={newsItem.title}
                width={860}
                height={480}
                loading="eager"
              />
            </div>
          )}
          {newsItem.deck && (
            <p class="news-lead" style="font-size: 1.2rem; color: #334155; line-height: 1.6; margin-top: 20px;">
              {newsItem.deck}
            </p>
          )}
        </header>

        {/* Event Details Callout */}
        {isEvent && (
          <aside class="event-details-callout" aria-label="Event Information" style="display: flex; flex-wrap: wrap; gap: 24px; margin-bottom: 32px; padding: 20px; background: #eff6ff; border: 1px solid #bfdbfe; border-left: 4px solid #2563eb; border-radius: 6px;">
            <div>
              <div style="font-size: 0.75rem; font-weight: 700; color: #1e40af; text-transform: uppercase; letter-spacing: 0.05em;">Event Date</div>
              <div style="font-size: 1rem; font-weight: 600; color: #0f172a; margin-top: 4px;">{formattedDate}</div>
            </div>
            <div>
              <div style="font-size: 0.75rem; font-weight: 700; color: #1e40af; text-transform: uppercase; letter-spacing: 0.05em;">Location & Venue</div>
              <div style="font-size: 1rem; font-weight: 600; color: #0f172a; margin-top: 4px;">Taipei Nangang Exhibition Center (Hall 1, Booth I1431)</div>
            </div>
          </aside>
        )}

        {/* News Article Body */}
        <div class="news-body prose" style="line-height: 1.8; font-size: 1.05rem; color: #1e293b;" set:html={sanitizeRichText(String(newsItem.body ?? ''))} />

        {/* Social Share Box */}
        <section class="news-share" aria-label="Share update" style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin: 40px 0 24px; padding: 16px 20px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;">
          <span style="font-size: 0.9rem; font-weight: 600; color: #334155;">Share this update:</span>
          <button type="button" id="copyNewsLinkBtn" class="btn btn-sm" aria-label="Copy link to clipboard" style="background: #fff; border: 1px solid #cbd5e1; padding: 6px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 500; cursor: pointer; color: #0f172a;">
            🔗 Copy Link
          </button>
          <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(newsItem.title)}&url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="btn btn-sm" aria-label="Share on X (opens in a new tab)" style="background: #fff; border: 1px solid #cbd5e1; padding: 6px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 500; text-decoration: none; color: #0f172a;">
            Share on X ↗
          </a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="btn btn-sm" aria-label="Share on LinkedIn (opens in a new tab)" style="background: #fff; border: 1px solid #cbd5e1; padding: 6px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 500; text-decoration: none; color: #0f172a;">
            LinkedIn ↗
          </a>
          <span id="copyNewsFeedback" aria-live="polite" style="display: none; font-size: 0.85rem; color: #16a34a; font-weight: 600;">
            ✓ Link copied!
          </span>
        </section>

        {/* Helpful Feedback Widget */}
        <section class="news-feedback" aria-labelledby="feedback-heading" style="margin-top: 36px; padding: 24px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; text-align: center;">
          <h3 id="feedback-heading" class="h3" style="font-size: 1.15rem; color: #0f172a; margin-bottom: 12px; font-weight: 600;">
            Was this update helpful?
          </h3>
          <div class="feedback-actions" id="newsFeedbackActions" style="display: flex; justify-content: center; gap: 14px;">
            <button type="button" class="btn btn-helpful" data-vote="yes" data-slug={newsItem.slug} aria-label="Yes, this was helpful" style="padding: 8px 24px; border: 1px solid #cbd5e1; background: #fff; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 0.9rem; color: #0f172a;">
              👍 Yes
            </button>
            <button type="button" class="btn btn-helpful" data-vote="no" data-slug={newsItem.slug} aria-label="No, this was not helpful" style="padding: 8px 24px; border: 1px solid #cbd5e1; background: #fff; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 0.9rem; color: #0f172a;">
              👎 No
            </button>
          </div>
          <p id="newsFeedbackMsg" class="feedback-msg" aria-live="polite" style="display: none; margin-top: 12px; font-size: 0.9rem; color: #16a34a; font-weight: 600;"></p>
        </section>

        {/* Related News / Events */}
        {relatedNews.length > 0 && (
          <section class="related-news" aria-labelledby="related-news-heading" style="margin-top: 56px; border-top: 1px solid #e2e8f0; padding-top: 36px;">
            <h2 id="related-news-heading" class="h2" style="font-size: 1.5rem; margin-bottom: 20px; color: #0f172a;">
              Recent Updates & Events
            </h2>
            <div class="related-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px;">
              {relatedNews.map((rel: any) => (
                <a href={`/news/${rel.slug}`} class="card card-pad" style="text-decoration: none; display: flex; flex-direction: column; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; background: #fff; transition: box-shadow 0.2s ease;">
                  <span style="font-size: 0.75rem; text-transform: uppercase; color: #2563eb; font-weight: 700; margin-bottom: 8px;">
                    {rel.tag || 'News'}
                  </span>
                  <h3 class="h3" style="font-size: 1.1rem; color: #0f172a; margin-bottom: 8px; line-height: 1.4;">
                    {rel.title}
                  </h3>
                  {rel.deck && (
                    <p style="font-size: 0.875rem; color: #64748b; line-height: 1.5; margin-bottom: 14px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                      {rel.deck}
                    </p>
                  )}
                  <span class="link-arrow" style="margin-top: auto; font-size: 0.875rem; font-weight: 600; color: #2563eb;">
                    Read update →
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}
      </article>
    ) : (
      <section class="news-not-found wrap" style="padding: 80px 16px; text-align: center;">
        <h1 class="h1" style="font-size: 2.25rem; margin-bottom: 16px; color: #0f172a;">News Post Not Found</h1>
        <p style="font-size: 1.1rem; color: #64748b; margin-bottom: 24px;">
          The requested article or event notice could not be located in our Newsroom.
        </p>
        <a href="/news" class="btn btn-primary" style="display: inline-block; background: #0A2540; color: #fff; padding: 10px 24px; border-radius: 6px; text-decoration: none; font-weight: 600;">
          Browse Newsroom
        </a>
      </section>
    )}
  </main>

  <script is:inline src="/assets/js/share-copy.js"></script>
</Layout>
