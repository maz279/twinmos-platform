---
// where-to-buy.astro — Dynamic SSR Page rendered from CMS Delivery API.
// Tasks D2, D8b / GPROV-100 = 100% / G-NOHARDCODE = 0 / WCAG 2.2 AA compliant.
import Layout from '../layouts/Layout.astro';
import BlockDispatcher from '../components/blocks/BlockDispatcher.astro';
import { getDeliveryPage } from '../lib/delivery';

const page = await getDeliveryPage('where-to-buy');
const title = page?.title ?? "Where to Buy — TwinMOS";
const desc = page?.seoDescription ?? "TwinMOS distributor locator by country — authorized distribution across the Middle East, Africa, Asia and beyond, plus verified online marketplaces.";
const blocks = page?.blocks ?? [];
---

<Layout title={title} desc={desc} >
  <main id="main">
    <div id="marketplaces" class="sr-only" aria-hidden="true"></div>
    <div id="trust" class="sr-only" aria-hidden="true"></div>
    <div id="locator" class="sr-only" aria-hidden="true"></div>
    <div id="offices" class="sr-only" aria-hidden="true"></div>
    <BlockDispatcher blocks={blocks} />
  </main>
</Layout>
