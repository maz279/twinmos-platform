const cur = DICT[locale!] ?? DICT['ar'];
const page = await getDeliveryPage('index', locale!).catch(() => null);
const hasBlocks = Array.isArray(page?.blocks) && page.blocks.length > 0;
const pageTitle = page?.title || cur.title;
const pageDesc = page?.seoDescription || cur.desc;
---
<Layout
  title={pageTitle}
  desc={pageDesc}
  locale={locale}
  hreflangGrid={true}
  bodyClass="page-home"
>
  <main id="main">
    {hasBlocks ? (
      <BlockDispatcher blocks={page.blocks} />
    ) : (
      <>
        <section class="page-hero hero" dir={dir}>
          <div class="wrap">
            <span class="eyebrow" data-i18n="hero.eyebrow">{cur.eyebrow}</span>
            <h1 class="h1" data-i18n="hero.title">{cur.heroTitle}</h1>
            <p class="lede" data-i18n="hero.lede">{cur.heroLede}</p>
            <p style="margin-top:22px;display:flex;gap:12px;flex-wrap:wrap">
              <a class="btn btn-accent btn-lg" href="/shop" data-i18n="hero.ctaShop">
                {cur.ctaShop} <span aria-hidden="true">{dir === 'rtl' ? '←' : '→'}</span>
              </a>
              <a class="btn btn-ghost btn-lg" href="/where-to-buy" data-i18n="hero.ctaBuy">
                {cur.ctaBuy}
              </a>
            </p>
          </div>
        </section>

        <section style="padding:clamp(40px,6vw,72px) 0;background:var(--bg-subtle, #f8fafc)" dir={dir}>
          <div class="wrap">
            <div style="margin-bottom:clamp(24px,4vw,36px)">
              <h2 class="h2" style="margin:0 0 10px">{cur.categoryHeading}</h2>
              <p class="lede" style="margin:0;max-width:680px">{cur.categoryLede}</p>
            </div>
            <div class="grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px">
              <div class="card card-pad" style="border:1px solid var(--border-color,#e2e8f0);border-radius:12px;background:#fff;padding:24px">
                <span class="chip" style="font-size:12px;font-weight:700;color:var(--brand-ink,#0A2540);margin-bottom:12px;display:inline-block">DRAM</span>
                <h3 class="h3" style="margin:0 0 8px;font-size:18px">{cur.dramTitle}</h3>
                <p style="margin:0 0 16px;color:var(--text-muted,#64748b);font-size:14px;line-height:1.5">{cur.dramDesc}</p>
                <a class="link-arrow" href="/shop?cat=dram" style="font-weight:700;font-size:14px">
                  {cur.ctaShop}
                </a>
              </div>
              <div class="card card-pad" style="border:1px solid var(--border-color,#e2e8f0);border-radius:12px;background:#fff;padding:24px">
                <span class="chip" style="font-size:12px;font-weight:700;color:var(--brand-ink,#0A2540);margin-bottom:12px;display:inline-block">SSD</span>
                <h3 class="h3" style="margin:0 0 8px;font-size:18px">{cur.ssdTitle}</h3>
                <p style="margin:0 0 16px;color:var(--text-muted,#64748b);font-size:14px;line-height:1.5">{cur.ssdDesc}</p>
                <a class="link-arrow" href="/shop?cat=ssd" style="font-weight:700;font-size:14px">
                  {cur.ctaShop}
                </a>
              </div>
              <div class="card card-pad" style="border:1px solid var(--border-color,#e2e8f0);border-radius:12px;background:#fff;padding:24px">
                <span class="chip" style="font-size:12px;font-weight:700;color:var(--brand-ink,#0A2540);margin-bottom:12px;display:inline-block">FLASH</span>
                <h3 class="h3" style="margin:0 0 8px;font-size:18px">{cur.flashTitle}</h3>
                <p style="margin:0 0 16px;color:var(--text-muted,#64748b);font-size:14px;line-height:1.5">{cur.flashDesc}</p>
                <a class="link-arrow" href="/shop?cat=flash" style="font-weight:700;font-size:14px">
                  {cur.ctaShop}
                </a>
              </div>
              <div class="card card-pad" style="border:1px solid var(--border-color,#e2e8f0);border-radius:12px;background:#fff;padding:24px">
                <span class="chip" style="font-size:12px;font-weight:700;color:var(--brand-ink,#0A2540);margin-bottom:12px;display:inline-block">ACCESSORIES</span>
                <h3 class="h3" style="margin:0 0 8px;font-size:18px">{cur.accTitle}</h3>
                <p style="margin:0 0 16px;color:var(--text-muted,#64748b);font-size:14px;line-height:1.5">{cur.accDesc}</p>
                <a class="link-arrow" href="/shop?cat=accessories" style="font-weight:700;font-size:14px">
                  {cur.ctaShop}
                </a>
              </div>
            </div>
          </div>
        </section>

        <section style="padding:clamp(36px,5vw,60px) 0;background:#0A2540;color:#fff" dir={dir}>
          <div class="wrap">
            <h2 class="h2" style="margin:0 0 28px;text-align:center;color:#fff">{cur.trustHeading}</h2>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:24px;text-align:center">
              <div style="padding:16px">
                <div style="font-size:28px;font-weight:800;color:#1DBF9F;margin-bottom:6px">{figures.countriesCount}+</div>
                <div style="font-size:14px;color:#94a3b8">{cur.trustGlobal}</div>
              </div>
              <div style="padding:16px">
                <div style="font-size:28px;font-weight:800;color:#1DBF9F;margin-bottom:6px">ISO 9001</div>
                <div style="font-size:14px;color:#94a3b8">{cur.trustQuality}</div>
              </div>
              <div style="padding:16px">
                <div style="font-size:28px;font-weight:800;color:#1DBF9F;margin-bottom:6px">100%</div>
                <div style="font-size:14px;color:#94a3b8">{cur.trustEndurance}</div>
              </div>
            </div>
