---
// P4 locale landings — /ar/, /hi/, /ru/, /zh-cn/, /fr/, /es/, /pt/, /de/.
// Fully localized pages with Header, Navigation, Hero, Showcase, and Footer.
// Closes Z-31 (T6.2.1 / T6.2.2 / LOC-02).
import Layout from '../../layouts/Layout.astro';
import BlockDispatcher from '../../components/blocks/BlockDispatcher.astro';
import { LOCALES, localeDir, SETTINGS_GROUP_DEFAULTS, resolveComputedFigures } from '@twinmos/shared';
import { getDeliverySettings, getDeliveryPage } from '../../lib/delivery';

export const prerender = false;

const { locale } = Astro.params;
if (locale === 'en') {
  return Astro.redirect('/', 301);
}
const isKnownLocale = LOCALES.includes(locale as any);
if (!isKnownLocale) {
  return Astro.rewrite('/404');
}

const dir = localeDir(locale!);
const settings = await getDeliverySettings().catch(() => ({} as Record<string, any>));
const figures = resolveComputedFigures({ ...SETTINGS_GROUP_DEFAULTS['site.figures'], ...(settings['site.figures'] || {}) });

const LOCALE_NAMES: Record<string, string> = {
  ar: 'العربية', hi: 'हिन्दी', ru: 'Русский', 'zh-cn': '简体中文',
  fr: 'Français', es: 'Español', pt: 'Português', de: 'Deutsch',
};

