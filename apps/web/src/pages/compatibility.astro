---
// compatibility.astro — Dynamic SSR Page rendered from CMS Delivery API.
// Tasks D2, D8b / GPROV-100 = 100% / G-NOHARDCODE = 0 / WCAG 2.2 AA compliant.
import Layout from '../layouts/Layout.astro';
import BlockDispatcher from '../components/blocks/BlockDispatcher.astro';
import { getDeliveryPage } from '../lib/delivery';

const page = await getDeliveryPage('compatibility');
const title = page?.title ?? "Compatibility Finder — TwinMOS";
const desc = page?.seoDescription ?? "Find TwinMOS memory and storage compatible with your laptop, desktop, motherboard or mini PC — platform facts, matched speeds and honest downclock notes.";
const blocks = page?.blocks ?? [];
---

<Layout title={title} desc={desc} >
  <main id="main">
    <BlockDispatcher blocks={blocks} />
  </main>
</Layout>
