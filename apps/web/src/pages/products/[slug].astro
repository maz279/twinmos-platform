---
// products/[slug].astro — Dual-routing SSR Handler for:
// 1. Category Catalogue Listings (/products/<category> e.g. /products/ssd-nvme)
// 2. Product Detail Pages (/products/<slug> e.g. /products/corex-pro-m2-pcie-gen-5-0-nvme-ssd)
// Satisfies T5.3.1 (Category Axis), T5.3.2 (PDP Gallery, Specs, Related, JSON-LD),
// and T5.3.3 (410 Gone for archived products within 5s).
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/chrome/Breadcrumb.astro';
import BlockDispatcher from '../../components/blocks/BlockDispatcher.astro';
import ResponsiveImage from '../../components/common/ResponsiveImage.astro';
import { getProductAssets } from '../../lib/productAssets';
import {
  getDeliveryProductWithStatus,
  getDeliveryProducts,
  getDeliveryFacets,
  getDeliveryPage,
  getDeliveryArticles,
} from '../../lib/delivery';

const { slug } = Astro.params;

// T3.2.2: The .html twin must not return 200
if (!slug || Astro.url.pathname.endsWith('.html')) {
  return new Response('Not Found', { status: 404, statusText: 'Not Found' });
}

// 1. Check if slug matches a known category axis (e.g. /products/ssd-nvme)
const facets = await getDeliveryFacets();
const categoryNames = new Map(((facets?.categories ?? []) as any[]).map((c) => [c.id, c.name]));
const categoryMatch = (facets?.categories ?? []).find((c: any) => c.slug === slug);

// Variables for Category View
let isCategoryPage = Boolean(categoryMatch);
let categoryProducts: any[] = [];
let categoryTotal = 0;

if (isCategoryPage) {
  const sort = Astro.url.searchParams.get('sort') || 'featured';
  const q = Astro.url.searchParams.get('q') || '';
  categoryProducts = await getDeliveryProducts({ cat: slug, sort, q: q || undefined });
  categoryTotal = categoryProducts.length;
}

// Variables for Product Detail Page (PDP)
const preview = Astro.url.searchParams.get('preview') ?? undefined;
let productRes: any = null;
let product: any = null;

if (!isCategoryPage) {
  productRes = await getDeliveryProductWithStatus(slug, preview);

  // T4.5.4 / CMS-E3 / T5.3.3: Archive returns 410 Gone within 5s
  if (productRes.isArchived || productRes.status === 410) {
    return new Response('410 Gone - This product has been archived and is no longer available in the active catalog.', {
      status: 410,
      statusText: 'Gone',
      headers: { 'Content-Type': 'text/plain; charset=utf-8' },
    });
  }

  product = productRes.product;

  // No fixture fallback products: unpublishing in the CMS must take the page down (ZT-043).
  if (!product) {
    Astro.response.status = 404;
    Astro.response.statusText = 'Not Found';
  }
}

// Data preparations for Category View
const catTitle = categoryMatch ? `${categoryMatch.name} — TwinMOS Products` : '';
const catDesc = categoryMatch ? `Explore high-performance TwinMOS ${categoryMatch.name}. Verified specifications, warranty coverage, and authorized dealer distribution.` : '';
const catBreadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Products', href: '/products' },
  ...(categoryMatch ? [{ label: categoryMatch.name }] : []),
];

// Data preparations for PDP
const priceUsd = product?.priceUsd ?? (slug === 'voltx-ddr5-udimm-16gb' ? '89.99' : null);
const pdpPage = !isCategoryPage ? await getDeliveryPage('product').catch(() => null) : null;
const pdpTitle = product ? `${product.name} — TwinMOS` : 'Product Not Found — TwinMOS';
const pdpDesc = product?.shortDescription ?? pdpPage?.seoDescription ?? 'TwinMOS high performance memory and storage solutions.';
const pdpBreadcrumbs = product
  ? [
      { label: 'Home', href: '/' },
      { label: 'Products', href: '/products' },
      ...(product.category?.name ? [{ label: product.category.name, href: `/products/${product.category.slug || slugify(product.category.name)}` }] : []),
      { label: product.name },
    ]
  : [
      { label: 'Home', href: '/' },
      { label: 'Products', href: '/products' },
      { label: '404 Not Found' },
    ];

function slugify(text: string) {
  return String(text).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}

function cleanSpecKey(key: string): string {
  if (!key) return key;
  return key
    .replace(/\bE\s+X\s+P\s+O\b/gi, 'EXPO')
    .replace(/\bN\s+A\s+N\s+D\b/gi, 'NAND')
    .replace(/\bM\s+T\s+B\s+F\b/gi, 'MTBF')
    .replace(/\bS\.\s*M\.\s*A\.\s*R\.\s*T\b/gi, 'S.M.A.R.T.')
    .replace(/\bS\s+M\s+A\s+R\s+T\b/gi, 'S.M.A.R.T.')
    .replace(/\bS\s+S\s+D\b/gi, 'SSD')
    .replace(/\bP\s+M\s+I\s+C\b/gi, 'PMIC')
    .replace(/\bP\s+C\s+B\b/gi, 'PCB')
    .replace(/\bR\s+G\s+B\b/gi, 'RGB')
    .replace(/\bU\s+D\s+I\s+M\s+M\b/gi, 'UDIMM')
    .replace(/\bS\s+O\s+D\s+I\s+M\s+M\b/gi, 'SODIMM')
    .replace(/\b1\s+T\s+B\b/gi, '1TB')
    .replace(/\b2\s+T\s+B\b/gi, '2TB')
    .replace(/\b4\s+T\s+B\b/gi, '4TB')
    .replace(/\b5\s+1\s+2\s+G\s+B\b/gi, '512GB')
    .replace(/\b2\s+5\s+6\s+G\s+B\b/gi, '256GB')
    .replace(/\b1\s+2\s+8\s+G\s+B\b/gi, '128GB');
}

function cleanSpecValue(val: unknown): string {
  if (typeof val !== 'string') return typeof val === 'object' ? JSON.stringify(val) : String(val);
  return val
    .replace(/\bE\s+X\s+P\s+O\b/gi, 'EXPO')
    .replace(/\bN\s+A\s+N\s+D\b/gi, 'NAND')
    .replace(/\bM\s+T\s+B\s+F\b/gi, 'MTBF')
    .replace(/\bS\s+S\s+D\b/gi, 'SSD')
    .replace(/\bP\s+M\s+I\s+C\b/gi, 'PMIC')
    .replace(/\bR\s+G\s+B\b/gi, 'RGB');
}

const rawSpecs = (() => {
  const dictionary = product?.specsDictionary && typeof product.specsDictionary === 'object' ? product.specsDictionary : {};
  const published = product?.specs && typeof product.specs === 'object' ? product.specs : {};
  // Grouped datasheet specs ("Group::Label") supersede the legacy flat dictionary.
  const grouped = Object.keys(published).some((key) => key.includes('::'));
  return grouped ? { ...published } : { ...dictionary, ...published };
})();
const specs = Object.entries(rawSpecs).map(([k, v]) => [cleanSpecKey(k), cleanSpecValue(v)]);

const badges = Array.isArray(product?.badges) ? [...product.badges] : [];
if (product?.isComingSoon && !badges.includes('Coming Soon')) {
  badges.push('Coming Soon');
}

const productAssets = getProductAssets(slug);
const pdpHeroImg = productAssets?.img
  || product?.img
  || (product?.heroMediaId ? `/api/media/${product.heroMediaId}` : null)
  || (Array.isArray(product?.gallery) && product.gallery[0])
  || (product?.category?.slug?.includes('dram') ? '/assets/img/card/voltx-rgb.webp' : '/assets/img/card/corex-pro.webp');

const productGallery = (productAssets?.gallery && productAssets.gallery.length > 0)
  ? productAssets.gallery
  : (Array.isArray(product?.gallery) && product.gallery.length > 0 ? product.gallery : [pdpHeroImg]);

// Buy-box facts are derived only from published specs — no invented claims.
const specLabel = (label: string) => {
  const wanted = label.toLowerCase();
  const hit = specs.find(([key]) => {
    const raw = String(key);
    const labelPart = raw.includes('::') ? raw.slice(raw.indexOf('::') + 2) : raw;
    return labelPart.toLowerCase() === wanted;
  });
  return hit ? String(hit[1]) : null;
};
const glanceFacts = [
  { label: 'Capacity', value: specLabel('Memory Size') || (product?.facets as any)?.cap },
  { label: 'Speed', value: specLabel('Memory Tested Speed') || specLabel('Speed Rating') || (product?.facets as any)?.gen },
  { label: 'Profile', value: specLabel('Performance Profile') || specLabel('XMP Profile') },
  { label: 'Voltage', value: specLabel('Tested Voltage') },
  { label: 'Lighting', value: specLabel('Lighting') },
].filter((fact) => Boolean(fact.value)).slice(0, 4);
// Full-bleed studio scenes (official RGB renders) are cropped to fill the
// gallery stage; transparent packshots and detail crops stay contained.
const galleryScenes = new Set(
  productGallery
    .map((src: string, i: number) => (/-(g2|g3)\./i.test(src) ? i : -1))
    .filter((i: number) => i >= 0),
);

// Specs may be grouped with "Group::Label" keys (official datasheet structure);
// legacy flat keys fall back to one "Technical details" group. JSONB does not
// preserve key order, so groups and rows use a deterministic reading order.
const SPEC_GROUP_ORDER = [
  'General Tech Specs',
  'Memory Compatibility',
  'Default Performance Recovery Profiles',
  'Speed & Timing',
  'Product Dimensions',
  'Warranty',
];
const SPEC_LABEL_ORDER = [
  'Memory Type', 'Module Type', 'Package Memory Pin', 'Heat Spreader', 'Memory Size',
  'Performance Profile', 'Memory Tested Speed', 'Tested Voltage', 'Memory Color',
  'Power Draw / PMIC', 'Lighting', 'System Compatibility', 'Platform',
  'Default (JEDEC)', 'XMP Profile', 'Speed Rating', 'CAS Latency', 'Extended Timing',
  'Dimensions (L x W x H)', 'Warranty',
];
const rankOf = (value: string, order: string[]) => {
  const rank = order.indexOf(value);
  return rank === -1 ? Number.MAX_SAFE_INTEGER : rank;
};
const specGroups = (() => {
  const groups = new Map<string, Array<[string, string]>>();
  for (const [key, value] of specs) {
    const raw = String(key);
    const sep = raw.indexOf('::');
    const group = sep >= 0 ? raw.slice(0, sep) : 'Technical details';
    const label = sep >= 0 ? raw.slice(sep + 2) : raw;
    if (!groups.has(group)) groups.set(group, []);
    groups.get(group)!.push([label, String(value)]);
  }
  return [...groups.entries()]
    .sort(([a], [b]) => rankOf(a, SPEC_GROUP_ORDER) - rankOf(b, SPEC_GROUP_ORDER) || a.localeCompare(b))
    .map(([title, rows]) => ({
      title,
      rows: rows.sort(([a], [b]) => rankOf(a, SPEC_LABEL_ORDER) - rankOf(b, SPEC_LABEL_ORDER) || a.localeCompare(b)),
    }));
})();

const specValue = (needle: string) => {
  const hit = specs.find(([key]) => String(key).toLowerCase().includes(needle));
  return hit ? String(hit[1]) : null;
};
const configRows = [
  { label: 'Capacity', value: specLabel('Memory Size') },
  { label: 'Speed', value: specLabel('Memory Tested Speed') || specLabel('Speed Rating') },
  { label: 'Latency', value: specLabel('CAS Latency') },
].filter((row) => Boolean(row.value));

const productDatasheets = (productAssets?.datasheets && productAssets.datasheets.length > 0)
  ? productAssets.datasheets
  : (Array.isArray(product?.datasheets) ? product.datasheets : []);

// Fetch related items if in PDP
let relatedProducts: any[] = [];
let relatedGuides: any[] = [];
if (product) {
  const allProds = await getDeliveryProducts().catch(() => []);
  const relatedCatId = product.categoryId ?? product.category?.id;
  const relatedCatName = product.category?.name;
  const sameCategory = allProds.filter(
    (p: any) =>
      p.slug !== product.slug &&
      ((relatedCatId && p.categoryId === relatedCatId) ||
        (relatedCatName && p.category?.name === relatedCatName)),
  );
  const pool = [...sameCategory];
  if (pool.length < 4) {
    for (const p of allProds) {
      if (pool.length >= 4) break;
      if (p.slug === product.slug || pool.some((item: any) => item.slug === p.slug)) continue;
      if (p.facets?.gen && p.facets.gen === product.facets?.gen) pool.push(p);
    }
  }
  relatedProducts = pool.slice(0, 4);

  const allArticles = await getDeliveryArticles().catch(() => []);
  relatedGuides = allArticles.slice(0, 3);
}

// Schema.org Product JSON-LD without invented offers
const siteOrigin = Astro.site || 'https://www.twinmos.com';
const fullHeroImg = pdpHeroImg
  ? (pdpHeroImg.startsWith('http') ? pdpHeroImg : new URL(pdpHeroImg, siteOrigin).toString())
  : undefined;

const PRODUCT_LD = product
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: product.name,
      description: pdpDesc,
      image: fullHeroImg ? [fullHeroImg] : undefined,
      sku: product.sku,
      category: product.category?.name ?? 'Storage & Memory',
      brand: {
        '@type': 'Brand',
        name: product.brand?.name ?? 'TwinMOS',
      },
      ...(priceUsd && Number(priceUsd) > 0
        ? {
            offers: {
              '@type': 'Offer',
              price: Number(priceUsd),
              priceCurrency: product.currency || 'USD',
              availability: 'https://schema.org/InStock',
            },
          }
        : {}),
    })
  : null;

if (isCategoryPage && categoryMatch) {
  const tags = `products, category:${categoryMatch.slug}`;
  Astro.response.headers.set('Cache-Tag', tags);
  Astro.response.headers.set('X-Cache-Tags', tags);
} else if (product) {
  const tags = `products, product:${product.slug}, product-id:${product.id}`;
  Astro.response.headers.set('Cache-Tag', tags);
  Astro.response.headers.set('X-Cache-Tags', tags);
}
---

{isCategoryPage ? (
  /* ========================================================================= */
  /* CATEGORY CATALOGUE VIEW (e.g. /products/ssd-nvme)                          */
  /* ========================================================================= */
  <Layout title={catTitle} desc={catDesc}>
    <Breadcrumb items={catBreadcrumbs} />

    <main id="main">
      <div class="page-hero">
        <div class="wrap">
          <span class="eyebrow">Category Catalogue</span>
          <h1 class="h1">{categoryMatch.name}</h1>
          <p class="lede">
            Explore all {categoryMatch.name} products engineered by TwinMOS. High-speed performance, rigorous QA, and global warranty backing.
          </p>
        </div>
      </div>

      <!-- Quick category tabs -->
      <section class="wrap" style="padding-top:16px;padding-bottom:8px">
        <div class="tabs" role="tablist" aria-label="Product categories" style="display:flex;gap:8px;overflow-x:auto;padding-bottom:8px;scrollbar-width:thin">
          <a href="/products" class="tab" role="tab" aria-selected="false" style="text-decoration:none;white-space:nowrap">
            All Products <span class="tab-cnt">({facets?.total ?? 0})</span>
          </a>
          {facets?.categories?.map((c: any) => (
            <a
              href={`/products/${c.slug}`}
              class={`tab ${c.slug === slug ? 'on' : ''}`}
              role="tab"
              aria-selected={c.slug === slug ? 'true' : 'false'}
              style="text-decoration:none;white-space:nowrap"
            >
              {c.name} <span class="tab-cnt">({c.count})</span>
            </a>
          ))}
        </div>
      </section>

      <!-- Category Products Grid & Filter Rail -->
      <section style="padding:16px 0 64px">
        <div class="wrap">
          <div class="shop-layout" style="display:grid;grid-template-columns:260px 1fr;gap:32px;align-items:start">
            
            <aside class="filters" aria-label="Category filters" style="background:#fff;border:1px solid #E5E0F2;border-radius:12px;padding:24px">
              <h2 style="font-size:16px;font-weight:700;margin:0 0 16px">Categories</h2>
              <div style="display:flex;flex-direction:column;gap:8px">
                <a href="/products" style="display:flex;align-items:center;justify-content:space-between;color:var(--body);text-decoration:none;font-size:13.5px;padding:4px 0">
                  <span>All Products</span>
                  <span class="cnt" style="font-size:12px;color:var(--muted)">{facets?.total ?? 0}</span>
                </a>
                {facets?.categories?.map((c: any) => (
                  <a
                    href={`/products/${c.slug}`}
                    style={`display:flex;align-items:center;justify-content:space-between;text-decoration:none;font-size:13.5px;padding:4px 0;${c.slug === slug ? 'font-weight:700;color:var(--accent-deep,#5B21B6)' : 'color:var(--body)'}`}
                  >
                    <span>{c.name}</span>
                    <span class="cnt" style="font-size:12px;color:var(--muted)">{c.count}</span>
                  </a>
                ))}
              </div>

              <div style="margin-top:24px;border-top:1px solid #E5E0F2;padding-top:16px">
                <h3 style="font-size:13px;font-weight:700;margin:0 0 6px;color:#5B21B6">TwinMOS Guarantee</h3>
                <p style="font-size:12px;color:var(--muted);margin:0;line-height:1.5">
                  Full warranty protection and ISO 9001 certified manufacturing quality on every unit.
                </p>
              </div>
            </aside>

            <div>
              <div class="toolbar" style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:20px;padding:12px 16px;background:#F7F5FE;border-radius:10px;border:1px solid #E5E0F2">
                <span class="result-count" style="font-size:14px;font-weight:700;color:var(--color-brand,#14123A)">
                  {categoryTotal} {categoryTotal === 1 ? 'product' : 'products'} in {categoryMatch.name}
                </span>
                <a href="/products" class="btn btn-ghost btn-sm" style="margin-left:auto">
                  View all products →
                </a>
              </div>

              <div class="grid g3" id="shopGrid" data-ssr="true" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:20px">
                {categoryProducts.map((p: any) => {
                  const cardAssets = getProductAssets(p.slug);
                  const productImg = cardAssets?.img || p.img || (p.gallery && p.gallery[0]) || '/assets/img/card/corex-pro.webp';
                  return (
                    <article class="card pcard prod-card" data-id={p.slug}>
                      <div class="pcard-img">
                        {(p.isNew || p.warranty) && (
                          <div class="badge">
                            {p.isNew && <span class="b-new">NEW</span>}
                          </div>
                        )}
                        <a href={`/products/${p.slug}`} aria-label={p.name}>
                          <img src={productImg} alt={p.name} loading="lazy" />
                        </a>
                        <button class="qv-btn" data-qv={p.slug} type="button" aria-label={`Quick view ${p.name}`}>
                          Quick view
                        </button>
                      </div>

                      <div class="pcard-body">
                        <span class="pcard-cat">{categoryNames.get(p.categoryId) || p.categoryName || 'Hardware'}</span>
                        <h3 class="h3 pcard-title">
                          <a class="pcard-name" href={`/products/${p.slug}`}>{p.name}</a>
                        </h3>
                        <span class="pcard-meta">{p.shortSpec || p.description}</span>
                        <div class="pcard-warranty">
                          {p.warranty && (
                            <span class={`chip ${/lifetime/i.test(p.warranty) ? 'ok' : 'warn'}`}>
                              {/warranty$/i.test(p.warranty) ? p.warranty : `${p.warranty} warranty`}
                            </span>
                          )}
                        </div>
                        <div class="pcard-foot">
                          <a href={`/products/${p.slug}`} class="btn btn-ghost btn-sm">View details</a>
                          <div class="pcard-actions">
                            <button class="cmp-btn" data-id={p.slug} type="button" title="Add to compare" aria-label={`Add ${p.name} to compare`}>
                              ⇄
                            </button>
                          </div>
                        </div>
                      </div>
                    </article>
                  );
                })}
              </div>
            </div>

          </div>
        </div>
      </section>
    </main>

    <style>
      @media (max-width: 900px) {
        .shop-layout {
          grid-template-columns: 1fr !important;
        }
        .filters {
          display: none;
        }
      }
    </style>
  </Layout>
) : (
  /* ========================================================================= */
  /* PRODUCT DETAIL PAGE (PDP)                                                */
  /* ========================================================================= */
  <Layout
    title={pdpTitle}
    desc={pdpDesc}
    breadcrumbs={pdpBreadcrumbs}
    noindex={!product}
    ogImage={product ? fullHeroImg : undefined}
    preloadImage={product ? pdpHeroImg : undefined}
    customLd={PRODUCT_LD ? [PRODUCT_LD] : []}
  >
    <main id="main">
      {product ? (
        <article class="pdp-container wrap">
          <div class="pdp-top-grid">

            <!-- Gallery & High-Resolution Image Island -->
            <div class="pdp-gallery-island">
              <div class="pdp-main-image">
                <img
                  id="pdpMainImg"
                  class={galleryScenes.has(0) ? 'is-scene' : ''}
                  src={pdpHeroImg}
                  alt={product.name}
                  width="720"
                  height="720"
                  loading="eager"
                  fetchpriority="high"
                />
                <span class="pdp-media-count"><span id="pdpImgIndex">1</span> / {productGallery.length}</span>
                {productGallery.length > 1 && (
                  <>
                    <button type="button" id="pdpPrevImg" class="pdp-media-arrow prev" aria-label="Previous product image">
                      ‹
                    </button>
                    <button type="button" id="pdpNextImg" class="pdp-media-arrow next" aria-label="Next product image">
                      ›
                    </button>
                  </>
                )}
                <button
                  type="button"
                  id="openLightboxBtn"
                  class="pdp-zoom"
                  aria-label={`Zoom high-resolution view of ${product.name}`}
                >
                  <span aria-hidden="true">🔍</span> Zoom
                </button>
              </div>

              {productGallery.length > 1 && (
                <div class="pdp-gallery-thumbs" role="tablist" aria-label="Product image gallery">
                  {productGallery.map((imgSrc: string, i: number) => (
                    <button
                      type="button"
                      class={`gallery-thumb ${i === 0 ? 'on' : ''}`}
                      role="tab"
                      aria-selected={i === 0 ? 'true' : 'false'}
                      aria-label={`View product image ${i + 1} of ${productGallery.length}`}
                      data-full={imgSrc}
                      data-index={i}
                      data-scene={galleryScenes.has(i) ? 'true' : 'false'}
                    >
                      <img src={imgSrc} alt="" loading="lazy" />
                    </button>
                  ))}
                </div>
              )}
            </div>

            <!-- Product Details Header -->
            <header class="pdp-info">
              {product.isComingSoon && (
                <div class="pdp-coming-soon-banner" style="background: #fff7ed; border: 1px solid #fdba74; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px; color: #9a3412; font-weight: 600;">
                  ⏳ Coming Soon — Product release scheduled. Check back for availability.
                </div>
              )}

              <div class="pdp-badges">
                <span class="pdp-chip">{categoryNames.get(product.categoryId) || product.categoryName || 'Hardware'}</span>
                {badges.map((badge: string) => (
                  <span class="pdp-chip">{badge}</span>
                ))}
                {product.warrantyTier && (
                  <span class="pdp-chip pdp-chip-gold">Warranty tier: {product.warrantyTier}</span>
                )}
              </div>

              <h1 class="h1 pdp-title">
                {product.name}
              </h1>

              {product.sku && (
                <p class="pdp-sku">
                  Model / SKU: <strong>{product.sku}</strong>
                </p>
              )}

              {priceUsd && Number(priceUsd) > 0 && (
                <div class="pdp-price" style="display:flex;align-items:baseline;gap:8px;margin-bottom:16px">
                  <span style="font-size:26px;font-weight:800;color:var(--color-brand, #14123A)">
                    {product.currency || 'USD'} {Number(priceUsd).toFixed(2)}
                  </span>
                  <span class="form-note" style="color: #6A6285; font-size: 0.875rem;">
                    MSRP — local pricing available via authorized channels
                  </span>
                </div>
              )}

              <!-- Variants / Capacities -->
              {product.variants && Array.isArray(product.variants) && product.variants.length > 0 && (
                <div class="pdp-variants" style="margin-bottom: 20px;">
                  <span style="font-size: 0.875rem; font-weight: 700; color: #5B5475; display: block; margin-bottom: 8px;">Available Capacities / Variants:</span>
                  <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                    {product.variants.map((v: any) => (
                      <span style="border: 1px solid #CBC4DE; background: #F7F5FE; padding: 6px 14px; border-radius: 6px; font-size: 0.875rem; font-weight: 600; color: #3E3859;">
                        {typeof v === 'object' ? (v.sku || JSON.stringify(v)) : String(v)}
                      </span>
                    ))}
                  </div>
                </div>
              )}

              {(product.shortDescription || product.description || product.shortSpec) && (
                <p class="pdp-lede">
                  {product.shortDescription || product.description || product.shortSpec}
                </p>
              )}

              <div class="pdp-ctas">
                <a href="/where-to-buy" class="btn btn-accent">
                  Where to buy
                </a>
                <a href="/quote" class="btn btn-ghost">
                  Request volume quote
                </a>
                {productDatasheets.length > 0 && (
                  <a
                    href={productDatasheets[0].url}
                    target="_blank"
                    rel="noopener"
                    class="btn btn-ghost"
                    style="display:inline-flex;align-items:center;gap:6px"
                    download
                  >
                    📄 Datasheet (PDF)
                  </a>
                )}
                <button
                  type="button"
                  class="btn btn-ghost cmp-btn"
                  data-id={product.slug}
                  aria-label={`Add ${product.name} to compare tray`}
                >
                  ⚖️ Compare
                </button>
              </div>

              {glanceFacts.length > 0 && (
                <div class="pdp-facts" aria-label="Key specifications">
                  {glanceFacts.map((fact) => (
                    <div class="pdp-fact">
                      <span>{fact.label}</span>
                      <b>{fact.value}</b>
                    </div>
                  ))}
                </div>
              )}

              {configRows.length > 0 && (
                <div class="pdp-configs" aria-label="Available configurations">
                  {configRows.map((row) => (
                    <div class="pdp-config-row">
                      <span>{row.label}</span>
                      <div>
                        {row.value!.split('|').map((v) => (
                          <b>{v.trim()}</b>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              )}

              <div class="pdp-trust">
                {product.warranty && (
                  <span>
                    🛡️ {product.warranty.toLowerCase().includes('warranty') ? product.warranty : `${product.warranty} warranty`}
                  </span>
                )}
                <span>🌍 Authorized global channels</span>
                {productDatasheets.length > 0 && <span>📄 Datasheet available</span>}
              </div>
            </header>
          </div>

          <!-- Specifications + downloads rail -->
          {(specGroups.length > 0 || productDatasheets.length > 0) && (
            <section class="pdp-details" aria-labelledby="specs-heading">
              <div class="section-head">
                <div>
                  <span class="eyebrow">Technical details</span>
                  <h2 id="specs-heading" class="h2">Specifications &amp; downloads</h2>
                </div>
              </div>
              <div class="pdp-details-grid">
                {specGroups.length > 0 && (
                  <div class="pdp-spec-panel">
                    {specGroups.map((group) => (
                      <section class="pdp-spec-group">
                        <h3>{group.title}</h3>
                        <dl class="pdp-spec-grid">
                          {group.rows.map(([label, value]) => (
                            <div class="pdp-spec-row">
                              <dt>{label}</dt>
                              <dd>{value}</dd>
                            </div>
                          ))}
                        </dl>
                      </section>
                    ))}
                  </div>
                )}
                <aside class="pdp-side-rail">
                  {productDatasheets.length > 0 && (
                    <div class="pdp-rail-card">
                      <h3>Downloads</h3>
                      <ul>
                        {productDatasheets.map((ds: any) => (
                          <li>
                            <a
                              href={ds.url || '#'}
                              target="_blank"
                              rel="noopener"
                              aria-label={`${ds.title || 'Product datasheet'} (opens in a new tab)`}
                            >
                              📄 {ds.title || 'Product datasheet'} <span aria-hidden="true">↗</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                  <div class="pdp-rail-card pdp-rail-help">
                    <h3>Need help choosing?</h3>
                    <p>Compare kits with the upgrade advisor, or ask our team for volume pricing and compatibility checks.</p>
                    <a href="/contact" class="btn btn-ghost btn-sm">Talk to support</a>
                  </div>
                  <div class="pdp-rail-card pdp-rail-help">
                    <h3>Buy with confidence</h3>
                    <p>
                      {product.warranty ? `${product.warranty} warranty. ` : ''}Authorized distribution and regional support in 93+ countries.
                    </p>
                    <a href="/where-to-buy" class="link-arrow">Find a partner →</a>
                  </div>
                </aside>
              </div>
            </section>
          )}

          <!-- Related products — same card system as the catalogue -->
          {relatedProducts.length > 0 && (
            <section class="pdp-related" aria-labelledby="related-heading">
              <div class="section-head">
                <div>
                  <span class="eyebrow">Same category</span>
                  <h2 id="related-heading" class="h2">Related products</h2>
                </div>
                <a href={product.category?.slug ? `/products/${product.category.slug}` : '/products'} class="link-arrow">
                  View full category →
                </a>
              </div>
              <div class="grid g4 pdp-related-grid">
                {relatedProducts.map((rp: any) => {
                  const rpAssets = getProductAssets(rp.slug);
                  const rpImg = rpAssets?.img || rp.img || '/assets/img/card/corex-pro.webp';
                  // Long marketing copy can sit in shortSpec on some environments;
                  // prefer the concise facet line so related cards match the catalogue.
                  const short = String(rp.shortSpec || '').trim();
                  const rpSpeed = rp.specs?.Speed || rp.specs?.['Memory Tested Speed'] || rp.specs?.['Speed Rating'];
                  const rpMeta =
                    short && short.length <= 48 && !/with a data transfer speed/i.test(short)
                      ? short
                      : rpSpeed || [rp.facets?.gen, rp.facets?.cap].filter(Boolean).join(' · ') || short || rp.description;
                  return (
                    <article class="card pcard" data-id={rp.slug}>
                      <div class="pcard-img">
                        <a href={`/products/${rp.slug}`} aria-label={rp.name}>
                          <img src={rpImg} alt={rp.name} loading="lazy" />
                        </a>
                        <button class="qv-btn" data-qv={rp.slug} type="button" aria-label={`Quick view ${rp.name}`}>
                          Quick view
                        </button>
                      </div>
                      <div class="pcard-body">
                        <span class="pcard-cat">
                          {categoryNames.get(rp.categoryId) || rp.categoryName || 'Hardware'}
                        </span>
                        <h3 class="h3 pcard-title">
                          <a class="pcard-name" href={`/products/${rp.slug}`}>{rp.name}</a>
                        </h3>
                        <span class="pcard-meta">{rpMeta}</span>
                        <div class="pcard-warranty">
                          {rp.warranty && (
                            <span class={`chip ${/lifetime/i.test(rp.warranty) ? 'ok' : 'warn'}`}>
                              {/warranty$/i.test(rp.warranty) ? rp.warranty : `${rp.warranty} warranty`}
                            </span>
                          )}
                        </div>
                        <div class="pcard-foot">
                          <a href={`/products/${rp.slug}`} class="btn btn-ghost btn-sm">View details</a>
                          <div class="pcard-actions">
                            <button
                              class="cmp-btn"
                              data-id={rp.slug}
                              type="button"
                              title="Add to compare"
                              aria-label={`Add ${rp.name} to compare`}
                            >
                              ⇄
                            </button>
                          </div>
                        </div>
                      </div>
                    </article>
                  );
                })}
              </div>
            </section>
          )}

          <!-- Related guides -->
          {relatedGuides.length > 0 && (
            <section class="pdp-guides" aria-labelledby="guides-heading">
              <div class="section-head">
                <div>
                  <span class="eyebrow">Keep learning</span>
                  <h2 id="guides-heading" class="h2">Buying guides &amp; explainers</h2>
                </div>
                <a href="/learn" class="link-arrow">Visit the knowledge hub →</a>
              </div>
              <div class="grid g3">
                {relatedGuides.map((g: any) => (
                  <a href={`/learn/${g.slug}`} class="card pdp-guide-card">
                    <span class="chip">{g.category || 'Guide'}</span>
                    <b>{g.title}</b>
                    <span class="pdp-guide-cta">Read guide →</span>
                  </a>
                ))}
              </div>
            </section>
          )}
        </article>
      ) : (
        <section class="pdp-not-found wrap" style="padding: 80px 16px; text-align: center;">
          <h1 class="h1" style="font-size: 2.25rem; margin-bottom: 16px;">Product Not Found</h1>
          <p style="font-size: 1.1rem; color: #6A6285; margin-bottom: 24px;">
            The requested product could not be located in our catalog.
          </p>
          <a href="/products" class="btn btn-primary" style="display: inline-block; background: #14123A; color: #fff; padding: 10px 20px; border-radius: 6px; text-decoration: none;">
            Browse All Products
          </a>
        </section>
      )}
    </main>

    <style>
      .tab {
        display: inline-flex;
        align-items: center;
        padding: 8px 16px;
        border-radius: 9999px;
        background: #F3EFFC;
        color: #191633 !important;
        font-weight: 600;
        font-size: 13.5px;
        transition: all .15s ease;
      }
      .tab:hover {
        background: #E5E0F2;
        color: #191633 !important;
      }
      .tab.on {
        background: linear-gradient(120deg,#6D28D9,#1D4ED8) !important;
        color: #FFFFFF !important;
        font-weight: 700;
      }
      .tab-cnt {
        font-size: 11px;
        font-weight: 700;
        margin-left: 6px;
        color: #3E3859;
      }
      .tab.on .tab-cnt {
        color: #FFFFFF !important;
      }
    </style>

    <!-- Lightbox Modal Dialog for full 1024x1024 visual inspection -->
    <dialog id="pdpLightbox" style="border:none;border-radius:16px;padding:0;background:rgba(5,14,26,0.92);backdrop-filter:blur(10px);max-width:92vw;max-height:92vh;box-shadow:0 25px 50px -12px rgba(0,0,0,0.5)">
      <div style="position:relative;padding:32px;display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:320px;min-height:320px">
        <button
          type="button"
          id="closeLightboxBtn"
          aria-label="Close high-resolution zoom view"
          style="position:absolute;top:16px;right:16px;background:rgba(255,255,255,0.2);color:#fff;border:none;border-radius:99px;width:36px;height:36px;font-size:18px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer"
        >
          ✕
        </button>
        <img id="lightboxImg" src={pdpHeroImg} alt={product ? product.name : ''} style="max-width:85vw;max-height:80vh;object-fit:contain;border-radius:8px" />
        <span style="color:#E5E0F2;font-size:13px;margin-top:12px;font-weight:600">{product ? product.name : ''} — Full High-Resolution Packshot</span>
      </div>
    </dialog>

    <script is:inline src="/assets/js/pdp-gallery.js" defer></script>
  </Layout>
)}

<script is:inline src="/assets/js/catalog-filters.js"></script>
