---
// article.astro — Legacy Article Route Redirector (ADR D-5, Task T3.2.2)
// Clean URLs canonically live at /learn/<slug>.
const slug = Astro.url.searchParams.get('id') || Astro.url.searchParams.get('slug');
const target = slug ? `/learn/${encodeURIComponent(slug)}` : '/learn';
return Astro.redirect(target, 301);
