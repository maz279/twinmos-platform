---
// partners.astro — Dynamic SSR Page rendered from CMS Delivery API.
// Tasks D2, D8b / GPROV-100 = 100% / G-NOHARDCODE = 0 / WCAG 2.2 AA compliant.
import Layout from '../layouts/Layout.astro';
import BlockDispatcher from '../components/blocks/BlockDispatcher.astro';
import { getDeliveryPage } from '../lib/delivery';

const page = await getDeliveryPage('partners');
const title = page?.title ?? "Partner Program — TwinMOS";
const desc = page?.seoDescription ?? "TwinMOS partner program: distributor, reseller and SI tiers with a partner portal.";
const blocks = page?.blocks ?? [];
---

<Layout title={title} desc={desc} >
  <main id="main">
    <BlockDispatcher blocks={blocks} />
  </main>
</Layout>
