---
// Footer.astro — Server-rendered footer. Columns and the legal bar come from
// the CMS footer menu (MS5.1 T5.1.3); brand, contact, social, figures and
// WhatsApp come from site settings (MS4.2 T4.2.1-T4.2.2).
interface NavItem {
  id?: number;
  title: string;
  targetUrl?: string | null;
  metadata?: Record<string, any>;
  children?: NavItem[];
}

interface Props {
  brand?: { name?: string; tagline?: string; logoUrl?: string; foundingYear?: number };
  contact?: { email?: string; salesEmail?: string; phone?: string; address?: string; country?: string };
  social?: Record<string, string | undefined>;
  figures?: { foundingYear?: number; countriesCount?: string; productCount?: number; years?: number };
  whatsapp?: { phoneNumber?: string; waUrl?: string; defaultMessage?: string };
  menu?: { items?: NavItem[] } | null;
}

const { brand = {}, contact = {}, social = {}, figures = {}, whatsapp = {}, menu = null } = Astro.props;
const currentYear = new Date().getFullYear();
const brandName = brand.name || 'TwinMOS Technologies';
const logoUrl = brand.logoUrl || '/assets/img/logo-400.webp';
const foundingYear = figures.foundingYear || brand.foundingYear || 1998;
const countries = figures.countriesCount || '93+';
const address = contact.address || 'Taipei, Taiwan';
const salesEmail = contact.salesEmail || contact.email || 'sales@twinmos.com';
// Fallbacks match www.twinmos.com/contact exactly (authoritative fact base, ZT-021).
const phone = contact.phone || '+886 970-368-077';
const waUrl = whatsapp.waUrl || (whatsapp.phoneNumber ? `https://wa.me/${whatsapp.phoneNumber.replace(/[^0-9]/g, '')}` : 'https://wa.me/886970368077');

const hrefOf = (item: NavItem) => item.targetUrl || '#';
const groups: NavItem[] = menu?.items ?? [];
const columns = groups.filter((group: NavItem) => group.metadata?.kind === 'column');
const contactGroup = groups.find((group: NavItem) => /contact/i.test(group.title));
const legalGroup = groups.find((group: NavItem) => /legal/i.test(group.title));
const quoteLink = contactGroup?.children?.[0];
const legalLinks = legalGroup?.children ?? [];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <a class="footer-logo" href="/" aria-label={`${brandName} home`}>
          <img src={logoUrl} alt={brandName} />
        </a>
        <p class="footer-tagline">
          {brand.tagline || 'Legendary memory brand'} since {foundingYear}. Memory modules, SSDs, portable storage and accessories trusted in {countries} countries.
        </p>
        <div class="footer-trust" aria-label="Company facts">
          <span>Since {foundingYear}</span>
          <span>{countries} countries</span>
          <span>ISO 9001</span>
        </div>
        <div class="social-row">
          {social.facebook && (
            <a href={social.facebook} aria-label="Facebook (opens in a new tab)" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.6-1.5H16V4.4c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.2v2H7v3h2.6V21z"/></svg>
            </a>
          )}
          {social.instagram && (
            <a href={social.instagram} aria-label="Instagram (opens in a new tab)" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.3" cy="6.8" r="1.2" fill="currentColor"/></svg>
            </a>
          )}
          {social.linkedin && (
            <a href={social.linkedin} aria-label="LinkedIn (opens in a new tab)" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6.94 5a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM3.2 8.5h3.5V21H3.2zM9.2 8.5h3.35v1.7h.05c.47-.85 1.6-1.75 3.3-1.75 3.53 0 4.18 2.2 4.18 5.06V21h-3.5v-6.6c0-1.57-.03-3.6-2.2-3.6-2.2 0-2.54 1.72-2.54 3.5V21H9.2z"/></svg>
            </a>
          )}
          {social.x && (
            <a href={social.x} aria-label="X (Twitter) (opens in a new tab)" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M17.7 3H21l-7.2 8.2L22.2 21h-6.4l-5-6.5L4.8 21H1.5l7.7-8.8L1.9 3h6.6l4.5 5.9L17.7 3zm-1.1 16h1.8L5.6 4.9H3.8L16.6 19z"/></svg>
            </a>
          )}
          {social.youtube && (
            <a href={social.youtube} aria-label="YouTube (opens in a new tab)" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M23 12s0-3.4-.43-5.02a2.6 2.6 0 0 0-1.83-1.84C19.1 4.7 12 4.7 12 4.7s-7.1 0-8.74.44A2.6 2.6 0 0 0 1.43 6.98C1 8.6 1 12 1 12s0 3.4.43 5.02a2.6 2.6 0 0 0 1.83 1.84c1.64.44 8.74.44 8.74.44s7.1 0 8.74-.44a2.6 2.6 0 0 0 1.83-1.84C23 15.4 23 12 23 12zM9.75 15.5v-7l6 3.5z"/></svg>
            </a>
          )}
          {social.pinterest && (
            <a href={social.pinterest} aria-label="Pinterest (opens in a new tab)" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 0C5.4 0 2 4.7 2 8.7c0 2.4.9 4.6 2.9 5.4.3.1.6 0 .7-.4l.3-1.2c.1-.3 0-.4-.2-.7-.6-.7-.9-1.6-.9-2.8 0-3.5 2.6-6.6 6.8-6.6 3.7 0 5.7 2.3 5.7 5.3 0 4-1.8 7.4-4.4 7.4-1.5 0-2.6-1.2-2.2-2.7.4-1.8 1.3-3.7 1.3-5 0-1.2-.6-2.1-1.9-2.1-1.5 0-2.7 1.6-2.7 3.7 0 1.3.4 2.2.4 2.2l-1.8 7.5c-.5 2.2-.1 4.9 0 5.2 0 .2.3.2.4.1.2-.2 2.2-2.7 2.9-5.2l.8-3.1c.4.8 1.6 1.5 2.9 1.5 3.8 0 6.4-3.5 6.4-8.2C22 3.6 18.4 0 12 0z"/></svg>
            </a>
          )}
        </div>
      </div>

      <div class="footer-newsletter">
        <h4>Product news from Taipei</h4>
        <p class="footer-newsletter-lede">Launches, firmware updates and buying guides from our engineering team — once a month, no noise.</p>
        <form id="nlForm" class="newsletter" method="post" data-tm-form>
          <input id="nlEmail" name="email" type="email" placeholder="Email for product news" aria-label="Email for newsletter" required />
          <button class="btn btn-accent btn-sm" type="submit">Join</button>
        </form>
        <p class="newsletter-privacy-notice" data-newsletter-notice>
          By joining you agree to our <a href="/legal?tab=privacy">Privacy Policy</a>. Unsubscribe anytime.
        </p>
      </div>
    </div>

    <div class="footer-links">
      {columns.map((column: NavItem) => (
        <div class="footer-col">
          <h4>{column.title}</h4>
          {(column.children ?? []).map((link: NavItem) => (
            <a href={hrefOf(link)}>{link.title}</a>
          ))}
        </div>
      ))}

      <div class="footer-contact">
        <h4>Contact</h4>
        <ul class="footer-contact-list">
          <li><span class="fc-label">HQ</span><span>{address}</span></li>
          <li><span class="fc-label">Email</span><a href={`mailto:${salesEmail}`}>{salesEmail}</a></li>
          <li><span class="fc-label">Phone</span><a href={`tel:${phone.replace(/[^+0-9]/g, '')}`}>{phone}</a></li>
          <li><span class="fc-label">Hours</span><span>Mon&ndash;Fri, 9am&ndash;5pm (Taipei)</span></li>
        </ul>
        <div class="footer-contact-actions">
          <a class="btn btn-accent btn-sm" href={quoteLink ? hrefOf(quoteLink) : '/quote'}>
            {quoteLink?.title || 'Request a quote'}
          </a>
          {waUrl && (
            <a href={waUrl} target="_blank" rel="noopener" class="footer-wa" aria-label="Chat on WhatsApp (opens in a new tab)">
              WhatsApp ↗
            </a>
          )}
        </div>
      </div>
    </div>

    <div class="footer-bar">
      <span>&copy; {currentYear} {brandName}. All rights reserved.</span>
      <span class="footer-legal">
        <button id="cookiePreferencesBtn" type="button">Cookie Preferences</button>
        {legalLinks.map((link: NavItem) => (
          <a href={hrefOf(link)}>{link.title}</a>
        ))}
        <a class="footer-top-link" href="#main">Back to top ↑</a>
      </span>
    </div>
  </div>
</footer>
