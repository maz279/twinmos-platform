---
// Header.astro — Server-rendered header with accessible navigation and mega-menus.
// Tasks D1a / GPROV-100 / GPARITY-D / WCAG 2.2 AA compliant.
interface Props {
  activePath?: string;
  currentLocale?: string;
}

const { activePath = '', currentLocale = 'en' } = Astro.props;

// Supported locales for global multi-language navigation (LOC-02)
const LOCALES = ['en', 'ar', 'hi', 'ru', 'zh-cn', 'fr', 'es', 'pt', 'de'] as const;
const activeLocale = (LOCALES as readonly string[]).includes(currentLocale.toLowerCase()) ? currentLocale : 'en';
void activeLocale;

const normalize = (p: string) => p.replace(/^\//, '').replace(/\/$/, '') || 'index.html';
const current = normalize(activePath);

const isCurrent = (p: string) => {
  const norm = normalize(p);
  if (norm === 'index.html' && (current === 'index.html' || current === '')) return true;
  return current === norm || current.startsWith(norm.replace('.html', ''));
};
