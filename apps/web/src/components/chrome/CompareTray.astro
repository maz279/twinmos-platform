---
// CompareTray.astro — Floating product comparison tray dock.
// Tasks D1b, D5b.
---

<div id="cmpTray" class="cmp-tray" style="display:none" role="region" aria-label="Product comparison tray">
  <div class="wrap" style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px">
    <div style="display:flex;align-items:center;gap:12px">
      <span style="font-weight:700;font-size:14px">Compare Products</span>
      <div id="cmpThumbnails" style="display:flex;gap:8px"></div>
    </div>
    <div style="display:flex;align-items:center;gap:10px">
      <button id="cmpClearBtn" class="btn btn-ghost btn-sm" type="button">Clear</button>
      <a id="cmpGoBtn" class="btn btn-accent btn-sm" href="/compare">Compare Now</a>
    </div>
  </div>
</div>
