---
// BlockDispatcher.astro — Comprehensive 31-component Dynamic Page Block Dispatcher.
// Supports all 25 CMS schema block types and forensic inventory components.
// Tasks D2, D8b / GREF-D / GPROV-100 / WCAG 2.2 AA compliant.
import { sanitizeRichText, replaceLogoToken, SETTINGS_GROUP_DEFAULTS, CANONICAL_WIDGET_ADVISORS, CANONICAL_WIDGET_WORKLOADS, CANONICAL_WIDGET_FLAGSHIPS } from '@twinmos/shared';
import type { Block } from '@twinmos/shared';
import {
  getDeliveryFacets,
  getDeliveryGlossary,
  getDeliveryPolicies,
  getDeliveryOffices,
  getDeliveryTestimonials,
  getDeliveryFaqs,
  getDeliveryProducts,
  getDeliveryArticles,
  getDeliveryFormDefinition,
  getDeliveryFormToken,
  getDeliveryCompatibility,
  getDeliverySettings,
  getDeliverySearchResults,
} from '../../lib/delivery';
import locatorData from '../../data/locator.json';
import { getDeliveryDistributors } from '../../lib/delivery';

interface Props {
  blocks?: Block[];
  className?: string;
}

const { blocks = [], className = '' } = Astro.props;

const CANONICAL_CONFIGS: Record<string, any> = {
  advisor: CANONICAL_WIDGET_ADVISORS,
  speed_visualizer: CANONICAL_WIDGET_WORKLOADS,
  flagship: CANONICAL_WIDGET_FLAGSHIPS,
  rgb_lab: { effects: ['Static', 'Breathing', 'Rainbow', 'Wave', 'Meteor'] },
  'rgb-lab': { effects: ['Static', 'Breathing', 'Rainbow', 'Wave', 'Meteor'] },
  counters: { stats: [{ num: 1998, label: 'Founded in Taipei' }, { num: 93, label: 'Countries Served' }, { num: 14000, label: 'MB/s Read Speed' }] },
  tabs: { items: [{ id: 'tab1', label: 'Overview', desc: 'TwinMOS memory and storage solutions.' }, { id: 'tab2', label: 'Specs', desc: 'Engineered to JEDEC and NVMe specifications.' }] },
};

// The shop widgets need the live category facets for their filter rail and category tiles.
// Only fetch when the page actually contains the product listing or category tiles block.
const needsShopFacets = blocks.some((b: any) => b?.type === 'widget:product-listing' || b?.type === 'categoryTiles' || b?.type === 'category-tiles');
const facets: any = needsShopFacets ? await getDeliveryFacets() : null;
const shopCategories: any[] = facets?.categories ?? [];
const isQuotePage = /^\/quote(\.html)?\/?$/.test(Astro.url.pathname);
const needsSliderFigures = blocks.some((b: any) => b?.type === 'slider' || b?.type === 'hero-slider');
const liveSettings: any = needsSliderFigures ? await getDeliverySettings() : {};
const liveFigures = { ...SETTINGS_GROUP_DEFAULTS['site.figures'], ...(liveSettings['site.figures'] || {}) };
const quoteProducts: any[] = isQuotePage ? await getDeliveryProducts() : [];

// MS4.8 data-bound blocks: product showcase, downloads and QVL read live CMS
// entities instead of literal rows stored in the block JSON.
const needsDeliveryProducts = blocks.some((b: any) =>
  b?.type === 'productShowcase' ||
  b?.type === 'productList' ||
  b?.type === 'product-rail' ||
  b?.type === 'downloadDatasheet' ||
  b?.type === 'downloads-gallery'
);
const deliveryProducts: any[] = needsDeliveryProducts && !isQuotePage ? await getDeliveryProducts() : quoteProducts;

const needsCompatibility = blocks.some((b: any) => b?.type === 'qvlCompatibility');
const deliveryCompatibility: any[] = needsCompatibility ? await getDeliveryCompatibility() : [];

// T4.8.1 whereToBuy: the locator grid is data-bound to the CMS distributor
// directory; the checked-in locator.json is only a cold-start fallback.
const REGION_LABELS: Record<string, string> = {
  me: 'Middle East & GCC', af: 'Africa', as: 'Asia-Pacific', eu: 'Europe', cis: 'Russia & CIS', am: 'Americas',
};
const needsLocator = blocks.some((b: any) => b?.type === 'distributor-locator' || b?.type === 'widget:locator-controls');
const deliveryDistributors: any[] = needsLocator ? await getDeliveryDistributors().catch(() => []) : [];
const toLocatorCard = (row: any) => ({
  cc: row.isoCountry || '',
  region: row.region,
  status: row.ctaConfig?.status || 'active',
  search: `${row.name} ${row.regionLabel ?? ''} ${row.tagline ?? ''} ${(row.cities || []).join(' ')}`.toLowerCase(),
  name: row.name,
  regionLabel: REGION_LABELS[row.region] || row.regionLabel || row.region,
  chip: row.tagline ? 'Verified channel' : 'Available on inquiry',
  chipClass: row.tagline ? 'ok' : '',
  tag: row.tagline || 'Named partners are shared on inquiry',
  note: row.note || '',
  cities: row.cities || [],
  actions: Array.isArray(row.ctaConfig?.actions) ? row.ctaConfig.actions : [
    { label: 'Contact the hub', href: '/contact', primary: true },
    { label: 'Email sales', href: `mailto:sales@twinmos.com?subject=${encodeURIComponent(row.name)} sales inquiry`, primary: false },
  ],
});
const locatorCards: any[] = deliveryDistributors.length > 0 ? deliveryDistributors.map(toLocatorCard) : locatorData.cards;
const locatorRegions: any[] = deliveryDistributors.length > 0
  ? [{ code: 'all', label: 'All regions', count: locatorCards.length, on: true },
     ...Object.entries(REGION_LABELS).map(([code, label]) => ({
       code, label,
       count: locatorCards.filter((c: any) => c.region === code).length,
       on: false,
     })).filter((r: any) => r.count > 0)]
  : locatorData.regions;

// MS4.8 Live Delivery Data for Articles
const needsArticles = blocks.some((b: any) =>
  b?.type === 'articleList' ||
  b?.type === 'article-cards' ||
  b?.type === 'article-index' ||
  b?.type === 'featured-articles' ||
  b?.type === 'article-feed' ||
  b?.type === 'learning-paths'
);
const deliveryArticles: any[] = needsArticles ? await getDeliveryArticles() : [];

// MS4.3 & MS4.8 Live Delivery Data for Glossary & Legal Policies
const needsGlossary = blocks.some((b: any) =>
  b?.type === 'widget:glossary-filter' ||
  b?.type === 'glossary-letter' ||
  b?.type === 'glossaryIndex' ||
  b?.type === 'glossary-index'
);
const glossaryTerms: any[] = needsGlossary ? await getDeliveryGlossary() : [];
const termsByLetter: Record<string, any[]> = {};
for (const t of glossaryTerms) {
  const l = (t.letter || t.term?.charAt(0) || 'A').toUpperCase();
  termsByLetter[l] = termsByLetter[l] || [];
  termsByLetter[l].push(t);
}

const needsPolicies = blocks.some((b: any) => b?.type === 'tabbed-rich-text' || b?.type === 'policyTabs');
const publishedPolicies: any[] = needsPolicies ? await getDeliveryPolicies() : [];

// MS4.7 Live Delivery Data for Offices, Testimonials, FAQs
const needsOffices = blocks.some((b: any) => b?.type === 'officeCards' || b?.type === 'office-cards' || b?.type === 'whereToBuy');
const deliveryOffices: any[] = needsOffices ? await getDeliveryOffices() : [];

const needsTestimonials = blocks.some((b: any) => b?.type === 'testimonial' || b?.type === 'testimonials');
const deliveryTestimonials: any[] = needsTestimonials ? await getDeliveryTestimonials() : [];

const needsFaqs = blocks.some((b: any) => b?.type === 'faq' || b?.type === 'faqAccordion' || b?.type === 'faq-accordion');
const deliveryFaqs: any[] = needsFaqs ? await getDeliveryFaqs() : [];

// MS4.8 Form Definitions for dynamic form blocks
const formBlocks = blocks.filter((b: any) => b?.type === 'form');
const formDefsByType: Record<string, any> = {};
let formToken = '';
if (formBlocks.length > 0) {
  formToken = await getDeliveryFormToken();
}
for (const fb of formBlocks) {
  const fType = (fb as any).formType || (isQuotePage ? 'quote' : 'contact');
  if (!formDefsByType[fType]) {
    formDefsByType[fType] = await getDeliveryFormDefinition(fType);
  }
}

// MS5.3/MS5.6 SSR Search Results for search-results widget with type facets
const needsSearch = blocks.some((b: any) => b?.type === 'widget:search-results');
const rawSearchQuery = needsSearch ? (Astro.url.searchParams.get('q') || '') : '';
const rawSearchType = needsSearch ? (Astro.url.searchParams.get('type') || 'all') : 'all';
const ssrSearchResults: any = rawSearchQuery ? await getDeliverySearchResults(rawSearchQuery, rawSearchType) : null;
---

<div class={`block-stream ${className}`}>
  {blocks.map((b: Block, idx: number) => {
    try {
      if (!b || !b.type) return null;
      const type: string = (b as any).type;
      const raw = b as any;
      const blockId = raw.id ?? `block-${idx}`;

      // If the block contains pre-compiled, sanitized HTML from the CMS/importer, render through strict DOMPurify
      if (raw.html && typeof raw.html === 'string' && raw.html.trim().length > 0) {
        return (
          <div class={`block-wrapper block-${type}`} data-block-id={blockId} data-block-type={type} set:html={sanitizeRichText(raw.html)} />
        );
      }

      switch (type as string) {
        case 'hero':
        case 'page-hero':
        case 'error-hero':
          return (
            <section class="block-hero page-hero" data-block-id={blockId}>
              <div class="wrap">
                {raw.eyebrow && <span class="eyebrow">{raw.eyebrow}</span>}
                {(() => {
                  let headingText = raw.title || raw.heading || '';
                  if (blockId === 'search-block-1' || (headingText.includes('Results for') && Astro.url.pathname.startsWith('/search'))) {
                    const qParam = Astro.url.searchParams.get('q') || '';
                    if (qParam) {
                      headingText = `Results for "${qParam.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')}"`;
                    }
                  }
                  return headingText ? <h1 class="h1" set:html={sanitizeRichText(replaceLogoToken(headingText))} /> : null;
                })()}
                {raw.lede && <p class="lede" set:html={sanitizeRichText(replaceLogoToken(raw.lede))} />}
                {Array.isArray(raw.chips) && raw.chips.length > 0 && (
                  <div class="pillar-row" aria-label="Business pillars" style="margin-top:16px">
                    {raw.chips.map((chip: string) => (
                      <span class="pillar-chip">{chip}</span>
                    ))}
                  </div>
                )}
                {Array.isArray(raw.ctas) && raw.ctas.length > 0 && (
                  <div style="margin-top:20px;display:flex;gap:12px;flex-wrap:wrap">
                    {raw.ctas.map((cta: any) => (
                      <a class={`btn ${cta.variant === 'secondary' || cta.variant === 'ghost' ? 'btn-ghost' : 'btn-accent'}`} href={cta.url || '#'}>
                        {cta.label}
                      </a>
                    ))}
                  </div>
                )}
                {Array.isArray(raw.jumpLinks) && raw.jumpLinks.length > 0 && (
                  <nav class="jump-links" aria-label="Page jump links" style="margin-top:20px;display:flex;gap:10px;flex-wrap:wrap">
                    {raw.jumpLinks.map((j: any) => (
                      <a href={`#${j.targetId}`} class="jump-chip" style="font-size:13px;font-weight:600;text-decoration:none;padding:6px 14px;border-radius:20px;background:#EEF2F6;color:#0A2540">
                        {j.label} ↓
                      </a>
                    ))}
                  </nav>
                )}
                {raw.searchForm && (
                  <form class="hero-search-form" action="/search" method="GET" role="search" style="margin-top:24px;display:flex;gap:8px;max-width:480px">
                    <input class="input" type="search" name="q" placeholder="Search products, articles, guides…" aria-label="Search site content" style="flex:1" />
                    <button class="btn btn-accent" type="submit">Search</button>
                  </form>
                )}
                {Array.isArray(raw.trustStats) && raw.trustStats.length > 0 && (
                  <div class="hero-stats-band" style="margin-top:32px">
                    <div class="hero-stats">
                      {raw.trustStats.map((st: any) => (
                        <div class="hero-stat-box">
                          <b class="hero-stat-num">{st.value}</b>
                          <span class="hero-stat-lbl">{st.label}</span>
                          {st.sub && <small class="hero-stat-sub">{st.sub}</small>}
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </section>
          );

        case 'slider':
        case 'hero-slider':
        case 'heroSlider': {
          const fallbackSlides = [
            {
              image: '/assets/img/bn/home-0.webp',
              alt: 'TwinMOS VOLTX DDR5 memory modules in a dark studio scene',
              kicker: `Legendary memory brand since ${liveFigures.foundingYear}`,
              title: 'Memory & storage, engineered to last',
              lede: `TwinMOS designs and manufactures DRAM, SSDs, portable storage and accessories trusted in ${liveFigures.countriesCount} countries.`,
              cta: 'Explore products',
              link: '/shop',
              accent: 'navy',
            },
            {
              image: '/assets/img/bn/home-1.webp',
              alt: 'TwinMOS CoreX Pro M.2 PCIe Gen 5.0 NVMe SSD',
              kicker: 'New flagship · PCIe Gen 5.0',
              title: 'Up to 14,000 MB/s the Gen 5 era is here',
              lede: 'CoreX Pro M.2 2280 rides PCIe Gen 5.0 x4 with NVMe 2.0, TLC 3D NAND and graphene cooling.',
              cta: 'View CoreX Pro',
              link: '/products/corex-pro-m2-pcie-gen-5-0-nvme-ssd',
              accent: 'gen5',
            },
            {
              image: '/assets/img/bn/home-2.webp',
              alt: 'TwinMOS VOLTX DDR5 RGB memory modules with addressable lighting',
              kicker: 'VOLTX gaming line',
              title: 'Light up your rig — VOLTX DDR5 RGB',
              lede: 'Addressable RGB bars, board-synced lighting and DDR5 frequencies for modern platforms.',
              cta: 'Enter the gaming hub',
              link: '/gaming',
              accent: 'voltx',
            },
          ];
          const slides = (Array.isArray(raw.slides) && raw.slides.length > 0) ? raw.slides : fallbackSlides;
          const interval = raw.intervalMs ?? 5000;
          return (
            <section class="hero hero-has-slider" data-block-id={blockId}>
              <div class="slider hero-slider" data-slider data-autoplay={raw.autoplay !== false ? interval : 0} aria-roledescription="carousel" aria-label="Featured highlights" style="position:relative">
                <button class="sl-arrow sl-prev" data-sl-prev aria-label="Previous slide" tabindex="-1">‹</button>
                <div class="sl-track">
                  {slides.map((s: any, idx: number) => (
                    <article class={`sl-slide ${idx === 0 ? 'on' : ''}`} data-accent={s.accent || 'navy'} role="group" aria-roledescription="slide" aria-label={`Slide ${idx + 1} of ${slides.length}`}>
                      {s.image && (
                        <div class="sl-bg">
                          <img src={s.image} alt={s.alt || 'TwinMOS slide image'} loading={idx === 0 ? 'eager' : 'lazy'} />
                        </div>
                      )}
                      <div class="wrap sl-content">
                        <div class="sl-copy">
                          {s.kicker && <span class="sl-kicker">{s.kicker}</span>}
                          {s.title && (idx === 0
                            ? <h1 class="sl-title" set:html={sanitizeRichText(replaceLogoToken(s.title))} />
                            : <h2 class="sl-title" set:html={sanitizeRichText(replaceLogoToken(s.title))} />
                          )}
                          {s.lede && <p class="sl-lede" set:html={sanitizeRichText(replaceLogoToken(s.lede))} />}
                          <div class="sl-ctas">
                            {Array.isArray(s.ctas) && s.ctas.length > 0 ? (
                              s.ctas.map((c: any, i: number) => (
                                <a class={`btn btn-lg ${i === 0 ? 'sl-cta1 btn-accent' : 'sl-cta2 btn-ghost'}`} href={c.url || '#'}>
                                  {c.label} <span aria-hidden="true">→</span>
                                </a>
                              ))
                            ) : s.cta ? (
                              <a class="btn btn-lg sl-cta1 btn-accent" href={s.link || '#'}>
                                {s.cta} <span aria-hidden="true">→</span>
                              </a>
                            ) : null}
                          </div>
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
                <button class="sl-arrow sl-next" data-sl-next aria-label="Next slide" tabindex="-1">›</button>
                {slides.length > 1 && (
                  <div class="sl-dots" role="tablist" aria-label="Slide dots">
                    {slides.map((_: any, idx: number) => (
                      <button class={`sl-dot ${idx === 0 ? 'on' : ''}`} data-sl-dot={idx} role="tab" aria-label={`Go to slide ${idx + 1}`} aria-selected={idx === 0 ? 'true' : 'false'}></button>
                    ))}
                  </div>
                )}
                {slides.length > 1 && (
                  <div class="sl-count" aria-hidden="true">
                    <b>01</b><i>/</i><span>{slides.length < 10 ? `0${slides.length}` : slides.length}</span>
                  </div>
                )}
                {raw.pauseControl !== false && (
                  <button class="slider-pause sl-pause" data-sl-pause type="button" aria-label="Pause slide auto-rotation" aria-pressed="false" style="position:absolute;bottom:20px;left:clamp(16px,4vw,40px);z-index:20;background:rgba(5,14,26,0.65);color:#fff;border:1px solid rgba(255,255,255,0.25);border-radius:99px;padding:8px 14px;font-size:12px;font-weight:700;display:inline-flex;align-items:center;gap:6px;cursor:pointer;backdrop-filter:blur(6px)">
                    <span class="pause-icon" aria-hidden="true">⏸</span>
                    <span class="pause-text">Pause</span>
                  </button>
                )}
              </div>
            </section>
          );
        }

        case 'stats':
        case 'statsCounter':
        case 'stat-strip':
        case 'statStrip':
        case 'stats-tiles':
        case 'stats-band-copy':
        case 'stats-demo': {
          const fallbackStats = [
            { value: '1998', label: 'Founded in Taipei, Taiwan' },
            { value: '93+', label: 'Countries Globally Served' },
            { value: '14,000', label: 'MB/s Next-Gen Read Speed' },
            { value: 'Lifetime', label: 'DRAM Module Warranty' },
          ];
          const stats = (Array.isArray(raw.stats) && raw.stats.length > 0) ? raw.stats : fallbackStats;
          return (
            <section class="block-stats" data-block-id={blockId} style="padding:40px 0;background:#F8FAFC">
              <div class="wrap" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:24px;text-align:center">
                {stats.map((stat: any) => (
                  <div class="stat-item b-cell">
                    <div style="font-size:36px;font-weight:800;color:#08705C">{stat.value}</div>
                    <div style="font-size:14px;color:var(--body);margin-top:4px">{stat.label}</div>
                  </div>
                ))}
              </div>
            </section>
          );
        }

        case 'features':
        case 'featureGrid':
        case 'card-grid':
        case 'icon-card-grid':
        case 'section-tiles':
          return (
            <section class="block-grid" data-block-id={blockId} style="padding:48px 0">
              <div class="wrap">
                {raw.title && <h2 class="h2">{raw.title}</h2>}
                {raw.heading && !raw.title && <h2 class="h2">{raw.heading}</h2>}
                {raw.subtitle && <p class="lede" style="margin-bottom:24px">{raw.subtitle}</p>}
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px">
                  {Array.isArray(raw.items) && raw.items.map((item: any) => (
                    <div class="card card-pad" style="border:1px solid #E6EBF1;border-radius:12px">
                      {item.icon && <div class="item-icon" style="font-size:24px;margin-bottom:8px">{item.icon}</div>}
                      <h3 class="h3" style="font-size:18px;margin-bottom:8px">{item.title}</h3>
                      <p style="color:var(--body);font-size:14px;line-height:1.6">{item.description || item.desc}</p>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          );

        case 'bentoGrid':
        case 'bento-grid':
          return (
            <section class="block-bento" data-block-id={blockId} style="padding:48px 0">
              <div class="wrap">
                {raw.title && <h2 class="h2">{raw.title}</h2>}
                {raw.heading && !raw.title && <h2 class="h2">{raw.heading}</h2>}
                <div class="bento-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;margin-top:24px">
                  {Array.isArray(raw.items) && raw.items.map((item: any) => (
                    <div class="bento-cell card card-pad" style="border:1px solid #E6EBF1;border-radius:12px">
                      <h3 class="h3" style="font-size:18px">{item.title}</h3>
                      <p style="color:var(--body);font-size:14px;margin-top:8px">{item.description || item.desc}</p>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          );

        case 'cta':
        case 'ctaBanner':
        case 'cta-banner':
        case 'cta-inline-card':
        case 'cta-row':
          return (
            <section class="block-cta" data-block-id={blockId} style="padding:60px 0">
              <div class="wrap">
                <div class="card card-pad" style="background:#0A2540;color:#fff;border-radius:16px;padding:48px 36px;text-align:center;position:relative;overflow:hidden">
                  {raw.badge && <span class="chip" style="background:rgba(255,255,255,0.15);color:#fff;margin-bottom:12px;display:inline-block">{raw.badge}</span>}
                  <h2 style="font-size:28px;font-weight:800;color:#fff;margin-bottom:12px" set:html={sanitizeRichText(replaceLogoToken(raw.title || raw.heading || ''))} />
                  {raw.subtitle && <p style="font-size:16px;color:#CBD5E1;max-width:640px;margin:0 auto 24px" set:html={sanitizeRichText(replaceLogoToken(raw.subtitle))} />}
                  {Array.isArray(raw.ctas) && raw.ctas.length > 0 && (
                    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
                      {raw.ctas.map((cta: any) => (
                        <a class={`btn ${cta.variant === 'secondary' || cta.variant === 'outline' ? 'btn-ghost' : 'btn-accent'}`} href={cta.url || '#'}>{cta.label}</a>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </section>
          );

        case 'splitCta':
        case 'cta-split': {
          const defaultLeft = { title: 'For Gamers & Creators', description: 'Experience maximum memory performance with VOLTX DDR5', ctaText: 'Explore Gaming', ctaUrl: '/gaming' };
          const defaultRight = { title: 'For Enterprises & OEMs', description: 'Scalable NAND storage and B2B volume pricing', ctaText: 'Partner with Us', ctaUrl: '/quote' };
          const left = raw.left || (raw.leftTitle ? { title: raw.leftTitle, description: raw.leftDesc || raw.leftBody, ctaText: raw.leftCtaLabel || raw.leftCtaText, ctaUrl: raw.leftUrl || raw.leftCtaHref } : defaultLeft);
          const right = raw.right || (raw.rightTitle ? { title: raw.rightTitle, description: raw.rightDesc || raw.rightBody, ctaText: raw.rightCtaLabel || raw.rightCtaText, ctaUrl: raw.rightUrl || raw.rightCtaHref } : defaultRight);
          return (
            <section class="block-split-cta" data-block-id={blockId} style="padding:48px 0">
              <div class="wrap" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px;position:relative">
                {left && (
                  <div class="card card-pad" style="background:#0A2540;color:#fff;border-radius:12px">
                    {left.title && <h3 class="h3" style="color:#fff" set:html={sanitizeRichText(replaceLogoToken(left.title))} />}
                    {left.description && <p style="color:#CBD5E1;margin:12px 0 20px" set:html={sanitizeRichText(replaceLogoToken(left.description))} />}
                    {left.ctaUrl && <a class="btn btn-accent btn-sm" href={left.ctaUrl}>{left.ctaText || 'Learn More'}</a>}
                  </div>
                )}
                {raw.dividerText && (
                  <div class="split-divider" style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);background:#F1F5F9;color:var(--body);padding:4px 10px;border-radius:12px;font-size:12px;font-weight:700">
                    {raw.dividerText}
                  </div>
                )}
                {right && (
                  <div class="card card-pad" style="border:1px solid #E6EBF1;border-radius:12px">
