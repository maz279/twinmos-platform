                      Media &amp; Articles <span class="chip" style="margin-left:6px">{ssrSearchResults?.facets?.article ?? arts.length}</span>
                    </a>
                    <a href={`/search?q=${encodeURIComponent(rawQ)}&type=glossary`} class={`btn btn-sm ${rawSearchType === 'glossary' ? 'btn-accent' : 'btn-ghost'}`}>
                      Glossary Terms <span class="chip" style="margin-left:6px">{ssrSearchResults?.facets?.glossary ?? terms.length}</span>
                    </a>
                  </div>
                )}

                <div id="searchMount" class="wrap" style="padding:0">
                  {rawQ && results.length > 0 ? (
                    <div class="ssr-search-results" style="display:flex;flex-direction:column;gap:28px">
                      {(rawSearchType === 'all' || rawSearchType === 'product') && prods.length > 0 && (
                        <section>
                          <h2 class="h3" style="display:flex;align-items:center;gap:8px;margin-bottom:14px">
                            Products <span class="chip">{prods.length}</span>
                          </h2>
                          <div class="grid g4" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px">
                            {prods.map((p: any) => (
                              <article class="card prod-card" style="border:1px solid #E6EBF1;border-radius:10px;padding:16px;background:#fff">
                                <span class="chip" style="font-size:11px;font-weight:700">{p.badge || 'Product'}</span>
                                <h3 class="h4" style="font-size:15px;margin:8px 0 4px">
                                  <a href={p.url} style="color:inherit;text-decoration:none">{p.title}</a>
                                </h3>
                                {p.snippet && <p style="font-size:12.5px;color:var(--muted);margin:0 0 10px">{p.snippet}</p>}
                                <a href={p.url} class="link-arrow" style="font-size:12.5px;font-weight:700">View product →</a>
                              </article>
                            ))}
                          </div>
                        </section>
                      )}

                      {(rawSearchType === 'all' || rawSearchType === 'article') && arts.length > 0 && (
                        <section>
                          <h2 class="h3" style="display:flex;align-items:center;gap:8px;margin-bottom:14px">
                            Media &amp; Articles <span class="chip">{arts.length}</span>
                          </h2>
                          <div class="grid g3" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px">
                            {arts.map((a: any) => (
                              <a class="card card-pad article-card" href={a.url} style="border:1px solid #E6EBF1;border-radius:10px;text-decoration:none;color:inherit;display:block">
                                <span class="chip" style="font-size:11px;font-weight:700">{a.badge || a.category || 'Article'}</span>
                                <b style="display:block;margin:8px 0 4px;font-size:15px">{a.title}</b>
                                {a.snippet && <p style="font-size:12.5px;color:var(--muted);margin:0">{a.snippet}…</p>}
                              </a>
                            ))}
                          </div>
                        </section>
                      )}

                      {(rawSearchType === 'all' || rawSearchType === 'glossary') && terms.length > 0 && (
                        <section>
                          <h2 class="h3" style="display:flex;align-items:center;gap:8px;margin-bottom:14px">
                            Glossary Terms <span class="chip">{terms.length}</span>
                          </h2>
                          <div class="grid g3" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px">
                            {terms.map((t: any) => (
                              <a class="card card-pad" href={t.url} style="border:1px solid #E6EBF1;border-radius:10px;text-decoration:none;color:inherit;display:block">
                                <span class="chip" style="font-size:11px;font-weight:700">Glossary</span>
                                <b style="display:block;margin:8px 0 4px;font-size:15px">{t.title}</b>
                                {t.snippet && <p style="font-size:12.5px;color:var(--muted);margin:0">{t.snippet}…</p>}
                              </a>
                            ))}
                          </div>
                        </section>
                      )}
                    </div>
                  ) : rawQ ? (
                    <div class="empty-state" style="padding:40px 20px;text-align:center;border:1px dashed #CBD5E1;border-radius:12px;background:#F8FAFC">
                      <h3 class="h3" style="margin-bottom:6px">No results found for “{safeQ}”</h3>
                      <p style="color:var(--muted);margin:0">Try searching for DDR5, NVMe, VOLTX, warranty, or another keyword.</p>
                    </div>
                  ) : null}
                </div>
              </div>
            </section>
          );
        }

        case 'widget:locator-controls': {
          const component = String(raw.component || '');
          if (component.includes('geoBar')) {
            return <div class="geo-bar" id="geoBar" hidden data-block-id={blockId} />;
          }
          if (component.includes('locChips')) {
            return (
              <div class="loc-chips" id="locChips" role="group" aria-label="Filter by region" data-block-id={blockId}>
                {locatorRegions.map((region: any) => (
                  <button
                    class={`lchip ${region.on ? 'on' : ''}`}
                    data-rg={region.code}
                    aria-pressed={region.on ? 'true' : 'false'}
                    type="button"
                  >
                    {region.label} <span>{region.count}</span>
                  </button>
                ))}
              </div>
            );
          }
          if (component.includes('loc-meta')) {
            return (
              <div class="loc-meta" data-block-id={blockId}>
                <span id="locCount" aria-live="polite">Showing {locatorCards.length} markets</span>
                <span class="loc-hint">Named partners are shared on inquiry — TwinMOS publishes only verified channels.</span>
              </div>
            );
          }
          if (component.includes('locEmpty')) {
            return (
              <div class="loc-empty" id="locEmpty" hidden data-block-id={blockId}>
                <h3 class="h3">No markets match</h3>
                <p class="form-note">Try another region or clear the search.</p>
              </div>
            );
          }
          return (
            <div class="loc-controls" data-block-id={blockId}>
              <div class="loc-search">
                <input
                  type="search"
                  id="locSearch"
                  class="input"
                  placeholder="Search country or city — e.g. Kenya, Dubai, Lagos…"
                  aria-label="Search distributor by country or city"
                />
              </div>
              <select id="locStatus" class="input" aria-label="Filter by channel status">
                <option value="all">All channel types</option>
                <option value="authorized">Authorized distribution</option>
                <option value="expanding">Expanding coverage</option>
                <option value="seeking">Seeking distributors</option>
                <option value="hub">TwinMOS hubs</option>
              </select>
            </div>
          );
        }

        case 'distributor-locator':
          return (
            <div class="grid g3 dgrid" id="locGrid" data-block-id={blockId}>
              {locatorCards.map((card: any) => (
                <div
                  class="dcard"
                  data-cc={card.cc}
                  data-region={card.region}
                  data-status={card.status}
                  data-search={card.search}
                >
                  <div class="dc-head">
                    <span class="dc-flag" aria-hidden="true">{card.cc}</span>
                    <div class="dc-title">
                      <b>{card.name}</b>
                      <span class="dc-region">{card.regionLabel}</span>
                    </div>
                  </div>
                  <span class={`chip ${card.chipClass === 'ok' ? 'ok' : card.chipClass === 'warn' ? 'warn' : ''} dc-chip`}>
                    {card.chip}
                  </span>
                  <p class="dc-tag">{card.tag}</p>
                  <p class="dc-note">{card.note}</p>
                  <div class="dc-cities">
                    {card.cities.map((city: string) => <span>{city}</span>)}
                  </div>
                  <div class="dc-actions">
                    {card.actions.map((action: any) => (
                      <a class={`btn ${action.primary ? 'btn-primary' : 'btn-ghost'} btn-sm`} href={action.href}>
                        {action.label}
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          );

        case 'widget:glossary-filter':
          return (
            <section style="padding-top:clamp(22px,3vw,36px)" data-block-id={blockId}>
              <div class="wrap">
                <div class="lidx-bar">
                  <nav class="lidx" aria-label="Glossary letters">
                    {'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').map((letter) => (
                      <a class="lidx-a" href={`#gL${letter}`} data-letter={letter}>
                        {letter}
                      </a>
                    ))}
                  </nav>
                  <div class="lsearch lsearch-sm">
                    <input
                      type="search"
                      id="glossQ"
                      placeholder="Filter terms — try &quot;latency&quot;…"
                      aria-label="Filter glossary terms"
                    />
                    <span class="chip" id="glossCount">
                      {glossaryTerms.length} terms
                    </span>
                  </div>
                </div>
              </div>
            </section>
          );

        case 'glossaryIndex':
        case 'glossary-index': {
          const showLetters = raw.showLettersFilter !== false;
          const lettersWithTerms = Object.keys(termsByLetter).sort();
          return (
            <section class="block-glossary-index" data-block-id={blockId} style="padding:48px 0">
              <div class="wrap">
                {raw.title && <h2 class="h2" style="margin-bottom:20px">{raw.title}</h2>}
                {showLetters && (
                  <div class="lidx-bar" style="margin-bottom:28px">
                    <nav class="lidx" aria-label="Glossary letters">
                      {'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').map((letter) => {
                        const hasTerms = (termsByLetter[letter] || []).length > 0;
                        return (
                          <a
                            class={`lidx-a ${hasTerms ? '' : 'disabled'}`}
                            href={hasTerms ? `#gL${letter}` : undefined}
                            data-letter={letter}
                            style={hasTerms ? '' : 'opacity:0.4;pointer-events:none'}
                          >
                            {letter}
                          </a>
                        );
                      })}
                    </nav>
                    <div class="lsearch lsearch-sm">
                      <input
                        type="search"
                        id="glossQ"
                        placeholder="Filter terms — try &quot;latency&quot;…"
                        aria-label="Filter glossary terms"
                      />
                      <span class="chip" id="glossCount">
                        {glossaryTerms.length} terms
                      </span>
                    </div>
                  </div>
                )}
                {glossaryTerms.length === 0 ? (
                  <div class="empty-state" style="padding:48px 0;text-align:center">
                    <p class="lede" style="color:var(--muted)">No glossary terms found.</p>
                  </div>
                ) : (
                  <div class="glossary-sections">
                    {lettersWithTerms.map((letter) => {
                      const terms = termsByLetter[letter] || [];
                      if (terms.length === 0) return null;
                      return (
                        <section class="lsec-letter" id={`gL${letter}`} data-letter={letter} style="margin-bottom:32px">
                          <div class="lgrp-h" style="display:flex;align-items:center;gap:12px;margin-bottom:16px;border-bottom:2px solid #E2E8F0;padding-bottom:8px">
                            <b style="font-size:24px;color:#0F172A">{letter}</b>
                            <span class="chip">{terms.length} terms</span>
                          </div>
                          <dl class="lterms" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px">
                            {terms.map((term: any) => (
                              <div
                                class="lterm card card-pad"
                                data-search={`${term.term} ${term.definition}`.toLowerCase()}
                                style="border:1px solid #E2E8F0;border-radius:8px;background:#FFFFFF;padding:16px"
                              >
                                <dt style="margin-bottom:8px">
                                  <b style="font-size:16px;color:#0F172A;display:block">{term.term}</b>
                                  {term.explainerSlug && (
                                    <a class="lterm-ref" href={`/learn/${term.explainerSlug}`} style="font-size:12px;color:#0066FF;text-decoration:none">
                                      Read the explainer →
                                    </a>
                                  )}
                                </dt>
                                <dd style="margin:0;font-size:14px;color:#475569;line-height:1.5">{term.definition}</dd>
                              </div>
                            ))}
                          </dl>
                        </section>
                      );
                    })}
                  </div>
                )}
              </div>
            </section>
          );
        }

        case 'glossary-letter': {
          const letterIdx = idx - 2;
          const letter = (letterIdx >= 0 && letterIdx < 26) ? String.fromCharCode(65 + letterIdx) : (raw.letter || 'A');
          const terms = termsByLetter[letter] || [];
          if (terms.length === 0) return null;

          return (
            <section class="lsec-letter" id={`gL${letter}`} data-letter={letter} data-block-id={blockId}>
              <div class="wrap">
                <div class="lgrp-h">
                  <b>{letter}</b>
                  <span class="chip">{terms.length} terms</span>
                </div>
                <dl class="lterms">
                  {terms.map((term: any) => (
                    <div
                      class="lterm"
                      data-search={`${term.term} ${term.definition}`.toLowerCase()}
                    >
                      <dt>
                        <b>{term.term}</b>
                        {term.explainerSlug && (
                          <a class="lterm-ref" href={`/learn/${term.explainerSlug}`}>
                            Read the explainer →
                          </a>
                        )}
                      </dt>
                      <dd>{term.definition}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </section>
          );
        }

        case 'empty-state':
          return (
            <div
              class="empty-state"
              id="glossEmpty"
              style="display:none;padding:48px 0;text-align:center"
              data-block-id={blockId}
            >
              <div class="wrap">
                <p class="lede" style="color:var(--muted)">
                  {raw.message || 'No matching glossary terms found.'}
                </p>
              </div>
            </div>
          );

        case 'form': {
          const formType = raw.formType || (isQuotePage ? 'quote' : 'contact');
          const AUTOCOMPLETE_TOKENS = new Set(['name','email','organization','phone','country-name','street-address','postal-code','tel']);
          const autocompleteFor = (f: any) => AUTOCOMPLETE_TOKENS.has(String(f.autocomplete || '')) ? f.autocomplete : (AUTOCOMPLETE_TOKENS.has(String(f.name || '')) ? f.name : undefined);
          const formDef = formDefsByType[formType];
          const formFields = ((formDef && Array.isArray(formDef.fields) && formDef.fields.length > 0)
            ? formDef.fields
            : (formType === 'quote' ? [
                { name: 'company', label: 'Company / organization', type: 'text', required: true, autocomplete: 'organization', placeholder: 'Enterprise Name' },
                { name: 'name', label: 'Contact name', type: 'text', required: true, autocomplete: 'name', placeholder: 'Your name' },
                { name: 'email', label: 'Business email', type: 'email', required: true, autocomplete: 'email', placeholder: 'name@company.com' },
                { name: 'country', label: 'Country', type: 'text', required: true, autocomplete: 'country-name', placeholder: 'e.g. United Arab Emirates' },
                { name: 'productInterest', label: 'Product interest', type: 'select', required: false, options: quoteProducts.map((p: any) => p.name || p.slug) },
                { name: 'quantity', label: 'Estimated quantity', type: 'number', required: true, placeholder: 'e.g. 250' },
                { name: 'message', label: 'Requirement details', type: 'textarea', required: true, minLength: 10, placeholder: 'Platform, capacities, timeline…' },
              ] : [
                { name: 'name', label: 'Name', type: 'text', required: true, autocomplete: 'name', placeholder: 'Jane Doe' },
                { name: 'email', label: 'Business email', type: 'email', required: true, autocomplete: 'email', placeholder: 'name@company.com' },
                { name: 'message', label: 'Message', type: 'textarea', required: true, minLength: 10, placeholder: 'How can we help you?' },
              ])).map((f: any) => (
            // The select is data-bound: a stored form definition must not freeze
            // the catalogue snapshot it was authored with.
            f.name === 'productInterest' && f.type === 'select' && quoteProducts.length > 0
              ? { ...f, options: quoteProducts.map((p: any) => p.name || p.slug) }
              : f
          ));

          const formTitle = raw.title || formDef?.title;
          const formDesc = raw.description || formDef?.description;
          const submitBtn = raw.submitButtonText || (formType === 'quote' ? 'Request a quote' : 'Send message');
          const successMsg = raw.successMessage || formDef?.successMessage || (formType === 'quote' ? 'Quote request received — your regional office will reply within one business day.' : 'Thank you — the TwinMOS team will reply within one business day.');

          return (
            <section class="block-form" data-block-id={blockId} data-form-type={formType} style="padding:32px 0">
              <div class="wrap" style="max-width:920px">
                <div class="card card-pad" data-form-box>
                  {formTitle && <h2 class="h2" style="margin-bottom:8px">{formTitle}</h2>}
                  {formDesc && <p class="lede" style="margin-bottom:24px;color:#64748B">{formDesc}</p>}
                  <form
                    data-tm-form
                    data-form-type={formType}
                    action={`/api/v1/forms/${formType}`}
                    method="POST"
                    novalidate
                    data-success={successMsg}
                    data-loaded-at={Date.now()}
                  >
                    <input type="text" name="hp" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;opacity:0;pointer-events:none" aria-hidden="true" />
                    <input type="hidden" name="formToken" value={formToken} />
                    <div class="form-grid">
                      {formFields.map((f: any) => {
                        const isFull = f.type === 'textarea' || f.name === 'message' || f.name === 'specifications';
                        return (
                          <div class={`fg ${isFull ? 'full' : ''}`} data-req={f.required ? 'true' : undefined} data-min={f.minLength || (f.type === 'textarea' ? 10 : undefined)}>
                            <label>
                              {f.label} {f.required && <span class="req">*</span>}
                            </label>
                            {f.type === 'textarea' ? (
                              <textarea
                                class="input"
                                name={f.name}
                                rows={4}
                                placeholder={f.placeholder || ''}
                                required={f.required}
                              ></textarea>
                            ) : f.type === 'select' ? (
                              <select
                                class="input"
                                name={f.name}
                                id={f.name === 'productInterest' ? 'qProduct' : `form-field-${f.name}`}
                                required={f.required}
                              >
                                <option value="">Select an option…</option>
                                {(f.name === 'productInterest' && quoteProducts.length > 0
                                  ? quoteProducts.map((p: any) => ({ value: p.name || p.slug, label: p.name || p.slug, slug: p.slug }))
                                  : (Array.isArray(f.options) ? f.options : [])
                                ).map((opt: any) => (
                                  <option value={typeof opt === 'string' ? opt : opt.value} data-slug={typeof opt === 'object' ? opt.slug : undefined}>
                                    {typeof opt === 'string' ? opt : opt.label}
                                  </option>
                                ))}
                              </select>
                            ) : (
                              <input
                                class="input"
                                type={f.type || 'text'}
                                name={f.name}
                                placeholder={f.placeholder || ''}
                                autocomplete={autocompleteFor(f)}
                                required={f.required}
                              />
                            )}
                            <span class="err">{f.placeholder ? `Please enter ${f.label.toLowerCase()}` : `Please fill out this field`}</span>
                          </div>
                        );
                      })}
                    </div>
                    <div class="fg full" style="margin-top:16px">
                      <label style="display:flex;align-items:flex-start;gap:10px;font-size:13px;color:#334155;cursor:pointer">
                        <input type="checkbox" name="consent" required style="margin-top:3px;accent-color:#0066FF" />
                        <span>I agree to the processing of my contact and inquiry data pursuant to the <a href="/legal?tab=privacy" style="color:#0066FF;text-decoration:underline;font-weight:600">TwinMOS Privacy Policy</a>. We never sell or share personal data.</span>
                      </label>
                    </div>
                    <button class="btn btn-primary btn-lg" type="submit" style="margin-top:18px">
                      {submitBtn}
                    </button>
                  </form>
                </div>
              </div>
            </section>
          );
        }


        case 'tabbed-rich-text':
        case 'policyTabs':
        case 'tabs': {
          // If raw tabs are explicitly provided (e.g. on non-legal tabbed pages), use them
          if (Array.isArray(raw.tabs) && raw.tabs.length > 0 && !raw.id?.includes('legal')) {
            return (
              <section class="block-tabs block-policy-tabs" data-block-id={blockId} style="padding:48px 0">
                <div class="wrap">
                  {raw.title && <h2 class="h2">{raw.title}</h2>}
                  {raw.description && <p class="lede">{raw.description}</p>}
                  <div class="tabs-header" role="tablist" aria-label={raw.title || 'Policy Tabs'}>
                    {raw.tabs.map((tab: any, tIdx: number) => (
                      <button role="tab" class={`tab-btn ${tIdx === 0 ? 'active' : ''}`} id={`tab-${blockId}-${tIdx}`} aria-selected={tIdx === 0 ? 'true' : 'false'}>
                        {tab.label || tab.title}
                      </button>
                    ))}
                  </div>
                  {raw.tabs.map((tab: any, tIdx: number) => (
                    <div role="tabpanel" class={`tab-content ${tIdx === 0 ? 'active' : ''}`} style={tIdx === 0 ? 'margin-top:20px' : 'display:none;margin-top:20px'}>
                      {tab.content && <div set:html={sanitizeRichText(tab.content)} />}
                      {tab.body && <p style="color:var(--body);line-height:1.6">{tab.body}</p>}
                    </div>
                  ))}
                </div>
              </section>
            );
          }

          // If publishedPolicies exists, dynamically bind tabs to live policies
          if (publishedPolicies.length > 0) {
            const defaultActiveSlug = raw.defaultSlug || publishedPolicies[0].slug;
            const activeIndex = Math.max(0, publishedPolicies.findIndex((p: any) => p.slug === defaultActiveSlug));

            return (
              <section class="block-policy-tabs" style="padding-top:clamp(22px,3vw,36px)" data-block-id={blockId}>
                <div class="wrap" style="max-width:900px">
                  {raw.title && <h2 class="h2" style="margin-bottom:20px">{raw.title}</h2>}
                  <div class="tabs" role="tablist" aria-label={raw.title || 'Legal & Policies'}>
                    {publishedPolicies.map((pol: any, pIdx: number) => (
                      <button
                        class={`tab ${pIdx === activeIndex ? 'on' : ''}`}
                        data-tab={`legal-${pol.slug}`}
                        role="tab"
                        aria-selected={pIdx === activeIndex ? 'true' : 'false'}
                      >
                        {pol.title || pol.name || pol.slug}
                      </button>
                    ))}
                  </div>

                  {publishedPolicies.map((pol: any, pIdx: number) => {
                    const polDate = pol.effectiveDate
                      ? new Date(pol.effectiveDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
                      : (pol.updatedAt ? new Date(pol.updatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'March 1, 2026');
                    return (
                      <div
                        class={`tabpane ${pIdx === activeIndex ? 'on' : ''}`}
                        id={`legal-${pol.slug}`}
                        role="tabpanel"
                        style={pIdx === activeIndex ? '' : 'display:none'}
                      >
                        <div class="card card-pad article-body">
                          {raw.showLastUpdated !== false && (
                            <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap">
                              <span class="chip ok" style="background:#ECFDF5;color:#047857;border:1px solid #A7F3D0">Operative policy</span>
                              <span class="chip" style="font-size:12px;color:var(--muted)">Version {pol.version || '1.0'} · Effective {polDate}</span>
                            </div>
                          )}
                          {pol.body ? (
                            <div set:html={sanitizeRichText(pol.body)} />
                          ) : (
                            <p>{pol.summary || 'TwinMOS official policy terms and conditions.'}</p>
                          )}
                          {(pol.slug === 'warranty' || pol.slug === 'warranty-policy') && (
                            <div style="margin-top:24px">
                              <a class="btn btn-primary" href="/rma">Start an RMA →</a>
                            </div>
                          )}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </section>
            );
          }

          // Otherwise render empty state or prototype tabs
          return (
            <section style="padding-top:clamp(22px,3vw,36px)" data-block-id={blockId}>
              <div class="wrap" style="max-width:900px">
                <div class="empty-state" style="padding:32px;text-align:center;border:1px dashed #CBD5E1;border-radius:12px;background:#F8FAFC">
                  <p class="lede" style="color:var(--muted);margin:0">No policies currently published.</p>
                </div>
              </div>
            </section>
          );
        }

        case 'anchorNav':
          return (
            <nav class="block-anchor-nav" data-block-id={blockId} aria-label={raw.title || 'In-page navigation'} style={raw.sticky !== false ? 'position:sticky;top:64px;z-index:30;background:#fff;border-bottom:1px solid #E6EBF1;padding:12px 0' : 'padding:12px 0;border-bottom:1px solid #E6EBF1'}>
              <div class="wrap" style="display:flex;gap:16px;align-items:center;overflow-x:auto">
                {raw.title && <span style="font-weight:700;font-size:13px;color:var(--body);text-transform:uppercase">{raw.title}</span>}
                {Array.isArray(raw.links) && raw.links.map((link: any) => (
                  <a href={`#${link.targetId}`} class="anchor-link" style="font-size:14px;color:#1F2A37;text-decoration:none;font-weight:600;padding:4px 8px;border-radius:6px">
                    {link.label}
                    {link.badge && <span class="badge" style="margin-left:6px;font-size:11px;background:#EEF2F6;padding:2px 6px;border-radius:10px">{link.badge}</span>}
                  </a>
                ))}
              </div>
            </nav>
          );

        case 'specComparison':
          return (
            <section class="block-spec-comparison" data-block-id={blockId} style="padding:48px 0;overflow-x:auto">
              <div class="wrap">
                {(raw.headline || raw.title) && <h2 class="h2" style="margin-bottom:24px">{raw.headline || raw.title}</h2>}
                <table class="spec-table" style="width:100%;border-collapse:collapse;font-size:14px">
                  {Array.isArray(raw.columns) && raw.columns.length > 0 && (
                    <thead>
                      <tr style="background:#F8FAFC">
                        <th style="padding:10px 12px;border-bottom:2px solid #E6EBF1;text-align:left">Feature</th>
                        {raw.columns.map((c: any) => (
                          <th style="padding:10px 12px;border-bottom:2px solid #E6EBF1;text-align:left">{c.name || c}</th>
                        ))}
                      </tr>
                    </thead>
                  )}
                  <tbody>
                    {Array.isArray(raw.rows) && raw.rows.map((r: any) => {
                      const vals = typeof r.values === 'string' ? r.values.split('|').map((s: string) => s.trim()) : (Array.isArray(r.values) ? r.values : []);
                      return (
                        <tr style="border-bottom:1px solid #F0F3F7">
                          <td style="padding:10px 12px;font-weight:600">{r.label || r.feature || ''}</td>
                          {vals.map((v: string) => (
                            <td style="padding:10px 12px">{v}</td>
                          ))}
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </section>
          );

        case 'appEmbed': {
          const wType = raw.widgetType || raw.widget || 'advisor';
          const defaultCfg = (CANONICAL_CONFIGS as any)[wType] || {};
          const cfg = (raw.config && Object.keys(raw.config).length > 0) ? raw.config : defaultCfg;
          const micro = raw.microcopy || {};
          return (
            <div
              class={`block-app-embed app-embed-${wType}`}
              data-block-id={blockId}
              data-widget={wType}
              data-config={JSON.stringify(cfg)}
              data-microcopy={JSON.stringify(micro)}
            >
              <div class="wrap">
                {raw.title && <h3 class="h3" style="margin-bottom:16px">{raw.title}</h3>}
                <div class="widget-mount" id={`widget-${wType}-${blockId}`} data-widget-type={wType}></div>
              </div>
            </div>
          );
        }

        case 'html':
          return (
            <div class="block-html" data-block-id={blockId} set:html={sanitizeRichText(raw.content || raw.html || '')} />
          );

        default:
          return (
            <div class={`block-custom block-${type}`} data-block-id={blockId} style="padding:32px 0">
              <div class="wrap">
                {raw.title && <h3 class="h3">{raw.title}</h3>}
                {raw.heading && !raw.title && <h3 class="h3">{raw.heading}</h3>}
                {raw.body && <p style="color:var(--body);margin-top:8px">{raw.body}</p>}
              </div>
            </div>
          );
      }
    } catch (err) {
      console.error(`[BlockDispatcher] Rendering error for block #${idx} (${(b as any)?.type}):`, err);
      return (
        <div class="block-error-boundary" data-block-id={`block-${idx}`} style="display:none" aria-hidden="true">
          <!-- Block rendering suppressed safely -->
        </div>
      );
    }
  })}
</div>
