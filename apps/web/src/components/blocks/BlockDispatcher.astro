---
// BlockDispatcher.astro — Comprehensive 31-component Dynamic Page Block Dispatcher.
// Supports all 25 CMS schema block types and forensic inventory components.
// Tasks D2, D8b / GREF-D / GPROV-100 / WCAG 2.2 AA compliant.
import type { Block } from '@twinmos/shared';

interface Props {
  blocks?: Block[];
  className?: string;
}

const { blocks = [], className = '' } = Astro.props;
---

<div class={`block-stream ${className}`}>
  {blocks.map((b: Block, idx: number) => {
    try {
      if (!b || !b.type) return null;
      const type: string = (b as any).type;
      const raw = b as any;
      const blockId = raw.id ?? `block-${idx}`;

      // If the block contains pre-compiled, sanitized HTML from the CMS/importer, render directly
      if (raw.html && typeof raw.html === 'string' && raw.html.trim().length > 0) {
        return (
          <div class={`block-wrapper block-${type}`} data-block-id={blockId} data-block-type={type} set:html={raw.html} />
        );
      }

      switch (type as string) {
        case 'hero':
        case 'page-hero':
        case 'error-hero':
          return (
            <section class="block-hero page-hero" data-block-id={blockId}>
              <div class="wrap">
                {raw.eyebrow && <span class="eyebrow">{raw.eyebrow}</span>}
                {raw.title && <h1 class="h1">{raw.title}</h1>}
                {raw.heading && !raw.title && <h1 class="h1">{raw.heading}</h1>}
                {raw.lede && <p class="lede">{raw.lede}</p>}
                {Array.isArray(raw.chips) && raw.chips.length > 0 && (
                  <div class="pillar-row" aria-label="Business pillars" style="margin-top:16px">
                    {raw.chips.map((chip: string) => (
                      <span class="pillar-chip">{chip}</span>
                    ))}
                  </div>
                )}
                {Array.isArray(raw.ctas) && raw.ctas.length > 0 && (
                  <div style="margin-top:20px;display:flex;gap:12px;flex-wrap:wrap">
                    {raw.ctas.map((cta: any) => (
                      <a class={`btn ${cta.variant === 'secondary' ? 'btn-ghost' : 'btn-accent'}`} href={cta.url || '#'}>
                        {cta.label}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </section>
          );

        case 'slider':
        case 'hero-slider':
          return (
            <section class="block-slider" data-block-id={blockId} style="padding:48px 0;background:#0A2540;color:#fff">
              <div class="wrap">
                {Array.isArray(raw.slides) && raw.slides.map((s: any) => (
                  <div class="slide-item" style="padding:20px;text-align:center">
                    <h3 class="h3" style="color:#fff">{s.title}</h3>
                    {s.kicker && <p style="color:#1DBF9F">{s.kicker}</p>}
                    {s.image && <img src={s.image} alt={s.alt || ''} style="max-height:320px;margin:16px auto;display:block" loading="lazy" />}
                  </div>
                ))}
              </div>
            </section>
          );

        case 'stats':
        case 'statsCounter':
        case 'stats-tiles':
        case 'stats-band-copy':
        case 'stats-demo':
          return (
            <section class="block-stats" data-block-id={blockId} style="padding:40px 0;background:#F8FAFC">
              <div class="wrap" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:24px;text-align:center">
                {Array.isArray(raw.stats) && raw.stats.map((stat: any) => (
                  <div class="stat-item b-cell">
                    <div style="font-size:36px;font-weight:800;color:#1DBF9F">{stat.value}</div>
                    <div style="font-size:14px;color:#66748A;margin-top:4px">{stat.label}</div>
                  </div>
                ))}
              </div>
            </section>
          );

        case 'features':
        case 'featureGrid':
        case 'card-grid':
        case 'icon-card-grid':
        case 'section-tiles':
          return (
            <section class="block-grid" data-block-id={blockId} style="padding:48px 0">
              <div class="wrap">
                {raw.title && <h2 class="h2">{raw.title}</h2>}
                {raw.heading && !raw.title && <h2 class="h2">{raw.heading}</h2>}
                {raw.subtitle && <p class="lede" style="margin-bottom:24px">{raw.subtitle}</p>}
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px">
                  {Array.isArray(raw.items) && raw.items.map((item: any) => (
                    <div class="card card-pad" style="border:1px solid #E6EBF1;border-radius:12px">
                      {item.icon && <div class="item-icon" style="font-size:24px;margin-bottom:8px">{item.icon}</div>}
                      <h3 class="h3" style="font-size:18px;margin-bottom:8px">{item.title}</h3>
                      <p style="color:#66748A;font-size:14px;line-height:1.6">{item.description || item.desc}</p>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          );

        case 'bentoGrid':
        case 'bento-grid':
          return (
            <section class="block-bento" data-block-id={blockId} style="padding:48px 0">
              <div class="wrap">
                {raw.title && <h2 class="h2">{raw.title}</h2>}
                {raw.heading && !raw.title && <h2 class="h2">{raw.heading}</h2>}
                <div class="bento-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;margin-top:24px">
                  {Array.isArray(raw.items) && raw.items.map((item: any) => (
                    <div class="bento-cell card card-pad" style="border:1px solid #E6EBF1;border-radius:12px">
                      <h3 class="h3" style="font-size:18px">{item.title}</h3>
                      <p style="color:#66748A;font-size:14px;margin-top:8px">{item.description || item.desc}</p>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          );

        case 'cta':
        case 'ctaBanner':
        case 'cta-banner':
        case 'cta-inline-card':
        case 'cta-row':
          return (
            <section class="block-cta" data-block-id={blockId} style="padding:60px 0">
              <div class="wrap">
                <div class="card card-pad" style="background:#0A2540;color:#fff;border-radius:16px;padding:48px 36px;text-align:center">
                  <h2 style="font-size:28px;font-weight:800;color:#fff;margin-bottom:12px">{raw.title || raw.heading}</h2>
                  {raw.subtitle && <p style="font-size:16px;color:#CBD5E1;max-width:640px;margin:0 auto 24px">{raw.subtitle}</p>}
                  {Array.isArray(raw.ctas) && raw.ctas.length > 0 && (
                    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
                      {raw.ctas.map((cta: any) => (
                        <a class="btn btn-accent" href={cta.url || '#'}>{cta.label}</a>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </section>
          );

        case 'splitCta':
        case 'cta-split':
          return (
            <section class="block-split-cta" data-block-id={blockId} style="padding:48px 0">
              <div class="wrap" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px">
                <div class="card card-pad" style="background:#0A2540;color:#fff;border-radius:12px">
                  <h3 class="h3" style="color:#fff">{raw.leftTitle || 'Explore Products'}</h3>
                  <p style="color:#CBD5E1;margin:12px 0 20px">{raw.leftDesc || 'Browse our full DRAM & SSD catalog.'}</p>
                  <a class="btn btn-accent btn-sm" href={raw.leftUrl || '/shop.html'}>Browse Catalog</a>
                </div>
                <div class="card card-pad" style="border:1px solid #E6EBF1;border-radius:12px">
                  <h3 class="h3">{raw.rightTitle || 'Partner With Us'}</h3>
                  <p style="color:#66748A;margin:12px 0 20px">{raw.rightDesc || 'Authorized distribution and OEM manufacturing.'}</p>
                  <a class="btn btn-primary btn-sm" href={raw.rightUrl || '/quote.html'}>Get a Quote</a>
                </div>
              </div>
            </section>
          );

        case 'timeline':
          return (
            <section class="block-timeline" data-block-id={blockId} style="padding:48px 0">
              <div class="wrap">
                {raw.title && <h2 class="h2" style="margin-bottom:24px">{raw.title}</h2>}
                {raw.heading && !raw.title && <h2 class="h2" style="margin-bottom:24px">{raw.heading}</h2>}
                <div class="timeline-list" style="border-left:2px solid #E6EBF1;padding-left:20px">
                  {Array.isArray(raw.items) && raw.items.map((it: any) => (
                    <div class="timeline-item" style="margin-bottom:20px">
                      <strong style="color:#1DBF9F">{it.date}</strong>
                      <h4 class="h4" style="margin:4px 0">{it.title}</h4>
                      <p style="color:#475467">{it.desc || it.description}</p>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          );

        case 'textMedia':
        case 'rich-text+factfile':
        case 'text-columns':
          return (
            <section class="block-text-media" data-block-id={blockId} style="padding:48px 0">
              <div class="wrap" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:32px;align-items:start">
                <div class="text-col">
                  {raw.eyebrow && <span class="eyebrow">{raw.eyebrow}</span>}
                  {raw.title && <h2 class="h2">{raw.title}</h2>}
                  {raw.heading && !raw.title && <h2 class="h2">{raw.heading}</h2>}
                  {raw.body && <div style="color:#475467;line-height:1.6;margin-top:16px">{raw.body}</div>}
                </div>
                {raw.factfile && (
                  <aside class="card card-pad factfile" style="border:1px solid #E6EBF1;border-radius:12px">
                    <h3 class="h3" style="margin-bottom:12px">{raw.factfile.title || 'Fact File'}</h3>
                    <dl>
                      {Array.isArray(raw.factfile.facts) && raw.factfile.facts.map((f: any) => (
                        <div style="margin-bottom:8px">
                          <dt style="font-weight:700;color:var(--muted);font-size:13px">{f.label}</dt>
                          <dd style="margin:0;font-size:14px;color:var(--body)">{f.value}</dd>
                        </div>
                      ))}
                    </dl>
                  </aside>
                )}
              </div>
            </section>
          );

        case 'faq':
        case 'faqAccordion':
        case 'tabbed-faq':
        case 'faq-accordion':
          return (
            <section class="block-faq" data-block-id={blockId} style="padding:48px 0">
              <div class="wrap">
                {raw.title && <h2 class="h2" style="margin-bottom:20px">{raw.title}</h2>}
                {raw.heading && !raw.title && <h2 class="h2" style="margin-bottom:20px">{raw.heading}</h2>}
                <div class="faq-list" style="display:flex;flex-direction:column;gap:12px">
                  {Array.isArray(raw.items) && raw.items.map((faq: any) => (
                    <details class="faq-item card card-pad" style="border:1px solid #E6EBF1;border-radius:8px;padding:16px">
                      <summary style="font-weight:700;cursor:pointer;font-size:16px">{faq.question || faq.q}</summary>
                      <p style="margin-top:12px;color:#475467;line-height:1.6">{faq.answer || faq.a}</p>
                    </details>
                  ))}
                </div>
              </div>
            </section>
          );

        case 'table':
        case 'spec-table':
          return (
            <section class="block-table" data-block-id={blockId} style="padding:40px 0;overflow-x:auto">
              <div class="wrap">
                {raw.title && <h3 class="h3" style="margin-bottom:16px">{raw.title}</h3>}
                {raw.heading && !raw.title && <h3 class="h3" style="margin-bottom:16px">{raw.heading}</h3>}
                <table style="width:100%;border-collapse:collapse;font-size:14px">
                  {Array.isArray(raw.headers) && (
                    <thead>
                      <tr>
                        {raw.headers.map((h: string) => (
                          <th style="padding:10px 12px;border-bottom:2px solid #E6EBF1;text-align:left;background:#F8FAFC">{h}</th>
                        ))}
                      </tr>
                    </thead>
                  )}
                  <tbody>
                    {Array.isArray(raw.rows) && raw.rows.map((row: string[]) => (
                      <tr>
                        {row.map((cell: string) => (
                          <td style="padding:10px 12px;border-bottom:1px solid #F0F3F7">{cell}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          );

        case 'productList':
        case 'productShowcase':
        case 'product-rail':
          return (
            <section class="block-product-showcase" data-block-id={blockId} style="padding:48px 0">
              <div class="wrap">
                {raw.title && <h2 class="h2">{raw.title}</h2>}
                {raw.heading && !raw.title && <h2 class="h2">{raw.heading}</h2>}
                {raw.subtitle && <p class="lede">{raw.subtitle}</p>}
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;margin-top:24px">
                  {Array.isArray(raw.products || raw.skus) && (raw.products || raw.skus).map((p: any) => (
                    <div class="card card-pad" style="border:1px solid #E6EBF1;border-radius:12px;padding:20px">
                      <h4 style="font-weight:700">{p.name || p.sku}</h4>
                      {p.note && <p style="font-size:13px;color:#66748A;margin-top:4px">{p.note}</p>}
                    </div>
                  ))}
                </div>
              </div>
            </section>
          );

        case 'whereToBuy':
        case 'distributor-locator':
        case 'marketplace-cards':
          return (
            <section class="block-where-to-buy" data-block-id={blockId} style="padding:48px 0">
              <div class="wrap">
                {raw.title && <h2 class="h2">{raw.title}</h2>}
                {raw.heading && !raw.title && <h2 class="h2">{raw.heading}</h2>}
                <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:20px">
                  {Array.isArray(raw.regions) && raw.regions.map((reg: any) => (
                    <a class="btn btn-ghost" href={reg.href || '#'} style="border:1px solid #CBD5E1;padding:8px 16px;border-radius:8px">
                      {reg.region || reg.name}
                    </a>
                  ))}
                </div>
              </div>
            </section>
          );

        case 'downloadDatasheet':
        case 'downloads-gallery':
          return (
            <section class="block-downloads" data-block-id={blockId} style="padding:40px 0">
              <div class="wrap">
                {raw.title && <h3 class="h3">{raw.title}</h3>}
                {raw.heading && !raw.title && <h3 class="h3">{raw.heading}</h3>}
                <div style="display:flex;flex-direction:column;gap:8px;margin-top:16px">
                  {Array.isArray(raw.files) && raw.files.map((f: any) => (
                    <a class="download-link" href={f.url} target="_blank" rel="noopener noreferrer" style="color:#0A2540;font-weight:600">
                      📄 {f.label || f.name}
                    </a>
                  ))}
                </div>
              </div>
            </section>
          );

        case 'testimonial':
        case 'testimonials':
          return (
            <section class="block-testimonial" data-block-id={blockId} style="padding:48px 0">
              <div class="wrap">
                <blockquote class="card card-pad" style="border-left:4px solid #1DBF9F;background:#F8FAFC;padding:24px;border-radius:8px">
                  <p style="font-size:18px;font-style:italic;color:#1F2A37;line-height:1.6">"{raw.quote || raw.body}"</p>
                  <footer style="margin-top:12px;font-size:14px;font-weight:700;color:#475467">
                    — {raw.author}{raw.role ? `, ${raw.role}` : ''}
                  </footer>
                </blockquote>
              </div>
            </section>
          );

        case 'badgeStrip':
        case 'badge-strip':
        case 'trust-badges':
          return (
            <section class="block-badge-strip" data-block-id={blockId} style="padding:24px 0">
              <div class="wrap" style="display:flex;gap:16px;flex-wrap:wrap;justify-content:center">
                {Array.isArray(raw.badges) && raw.badges.map((b: any) => (
                  <span class="badge" style="background:#EEF2F6;padding:6px 14px;border-radius:20px;font-size:13px;font-weight:600">
                    {typeof b === 'string' ? b : b.label}
                  </span>
                ))}
              </div>
            </section>
          );

        case 'qvlCompatibility':
          return (
            <section class="block-qvl" data-block-id={blockId} style="padding:48px 0;overflow-x:auto">
              <div class="wrap">
                {raw.title && <h2 class="h2" style="margin-bottom:16px">{raw.title}</h2>}
                {raw.heading && !raw.title && <h2 class="h2" style="margin-bottom:16px">{raw.heading}</h2>}
                {raw.description && <p class="lede" style="margin-bottom:20px">{raw.description}</p>}
                <table class="qvl-table" style="width:100%;border-collapse:collapse;font-size:14px">
                  <thead>
                    <tr style="background:#F8FAFC">
                      <th style="padding:10px 12px;border-bottom:2px solid #E6EBF1;text-align:left">Motherboard / Brand</th>
                      <th style="padding:10px 12px;border-bottom:2px solid #E6EBF1;text-align:left">Chipset / Socket</th>
                      <th style="padding:10px 12px;border-bottom:2px solid #E6EBF1;text-align:left">Speed / Profile</th>
                      <th style="padding:10px 12px;border-bottom:2px solid #E6EBF1;text-align:left">BIOS Version</th>
                      <th style="padding:10px 12px;border-bottom:2px solid #E6EBF1;text-align:left">Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    {Array.isArray(raw.items || raw.rows) && (raw.items || raw.rows).map((row: any) => (
                      <tr style="border-bottom:1px solid #F0F3F7">
                        <td style="padding:10px 12px;font-weight:600">{row.motherboard || row.board || row[0]}</td>
                        <td style="padding:10px 12px">{row.chipset || row[1] || 'Z790 / B650'}</td>
                        <td style="padding:10px 12px">{row.speed || row[2] || 'DDR5-6000'}</td>
                        <td style="padding:10px 12px">{row.bios || row[3] || 'Verified'}</td>
                        <td style="padding:10px 12px;color:#1DBF9F;font-weight:700">{row.status || row[4] || '✓ Qualified'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          );

        case 'kpiMeters':
        case 'steps':
        case 'kpi-meters+steps':
          return (
            <section class="block-kpi-meters block-steps" data-block-id={blockId} style="padding:48px 0">
              <div class="wrap">
                {raw.title && <h2 class="h2" style="margin-bottom:24px">{raw.title}</h2>}
                {raw.heading && !raw.title && <h2 class="h2" style="margin-bottom:24px">{raw.heading}</h2>}
                {Array.isArray(raw.meters || raw.items) && (
                  <div class="kpi-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;margin-bottom:24px">
                    {(raw.meters || raw.items).map((m: any) => (
                      <div class="card card-pad kpi-cell" style="border:1px solid #E6EBF1;border-radius:10px;padding:20px">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                          <span style="font-weight:700;font-size:15px">{m.label || m.title}</span>
                          <span style="font-weight:800;color:#1DBF9F;font-size:18px">{m.value}</span>
                        </div>
                        {m.percent != null && (
                          <div style="background:#E2E8F0;border-radius:4px;height:8px;overflow:hidden">
                            <div style={`background:#1DBF9F;height:100%;width:${m.percent}%`} />
                          </div>
                        )}
                        {m.note && <div style="font-size:12px;color:#66748A;margin-top:6px">{m.note}</div>}
                      </div>
                    ))}
                  </div>
                )}
                {Array.isArray(raw.steps) && (
                  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px">
                    {raw.steps.map((st: any, i: number) => (
                      <div class="step-card" style="padding:20px;border:1px solid #E6EBF1;border-radius:10px">
                        <div style="font-weight:800;color:#1DBF9F;font-size:20px;margin-bottom:8px">Step {i + 1}</div>
                        <h4>{st.title}</h4>
                        <p style="color:#66748A;font-size:14px">{st.description || st.desc}</p>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </section>
          );

        case 'callout':
          return (
            <aside class="block-callout" data-block-id={blockId} style="padding:24px 0">
              <div class="wrap">
                <div class="callout-box" style="border-left:4px solid #0A2540;background:#F8FAFC;padding:16px 20px;border-radius:4px">
                  {raw.title && <strong>{raw.title}</strong>}
                  <p style="margin-top:4px;color:#475467">{raw.message || raw.body}</p>
                </div>
              </div>
            </aside>
          );

        case 'linkChips':
        case 'link-chips':
        case 'link-list':
        case 'filter-chips':
        case 'anchor-nav':
          return (
            <nav class="block-link-chips" data-block-id={blockId} style="padding:16px 0">
              <div class="wrap" style="display:flex;gap:10px;flex-wrap:wrap">
                {Array.isArray(raw.chips) && raw.chips.map((ch: any) => (
                  <a href={ch.url || '#'} style="background:#F1F5F9;padding:6px 12px;border-radius:16px;text-decoration:none;font-size:13px;color:#0A2540">
                    {ch.label}
                  </a>
                ))}
              </div>
            </nav>
          );

        case 'categoryTiles':
        case 'category-tiles':
          return (
            <section class="block-category-tiles" data-block-id={blockId} style="padding:48px 0">
              <div class="wrap" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px">
                {Array.isArray(raw.categories) && raw.categories.map((cat: any) => (
                  <a href={cat.url || `/categories/${cat.slug}`} class="cat-tile" style="display:block;padding:24px;border:1px solid #E6EBF1;border-radius:12px;text-align:center;text-decoration:none;color:#0A2540">
                    <h4 style="font-weight:700">{cat.title || cat.name}</h4>
                  </a>
                ))}
              </div>
            </section>
          );

        case 'officeCards':
        case 'office-cards':
          return (
            <section class="block-office-cards" data-block-id={blockId} style="padding:48px 0">
              <div class="wrap">
                {raw.title && <h2 class="h2">{raw.title}</h2>}
                <div class="grid g3" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;margin-top:20px">
                  {Array.isArray(raw.offices) && raw.offices.map((of: any) => (
                    <div class="card office card-pad" style="border:1px solid #E6EBF1;border-radius:12px">
                      <span class="of-flag" style="font-size:24px">{of.flag}</span>
                      <span class="of-role" style="display:block;color:var(--muted);font-size:12px;font-weight:700">{of.country}</span>
                      <b style="display:block;margin:6px 0">{of.title || of.name}</b>
                      <address style="font-style:normal;font-size:13.5px;color:var(--body);line-height:1.5">{of.address}</address>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          );

        case 'articleList':
        case 'article-cards':
        case 'article-index':
        case 'featured-articles':
        case 'article-feed':
        case 'learning-paths':
          return (
            <section class="block-article-list" data-block-id={blockId} style="padding:48px 0">
              <div class="wrap">
                {raw.title && <h2 class="h2">{raw.title}</h2>}
                {raw.heading && !raw.title && <h2 class="h2">{raw.heading}</h2>}
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;margin-top:24px">
                  {Array.isArray(raw.articles) && raw.articles.map((art: any) => (
                    <article class="card card-pad" style="border:1px solid #E6EBF1;border-radius:12px">
                      {art.tag && <span class="chip" style="font-size:12px;font-weight:700;color:var(--accent-deep)">{art.tag}</span>}
                      <h3 class="h3" style="font-size:18px;margin:8px 0">
                        <a href={`/article.html?id=${art.slug || art.id}`} style="color:inherit;text-decoration:none">{art.title}</a>
                      </h3>
                      {art.excerpt && <p style="color:#66748A;font-size:14px;line-height:1.5">{art.excerpt}</p>}
                    </article>
                  ))}
                </div>
              </div>
            </section>
          );

        case 'form':
          return (
            <section class="block-form" data-block-id={blockId} style="padding:48px 0">
              <div class="wrap" style="max-width:680px">
                {raw.title && <h2 class="h2">{raw.title}</h2>}
                {raw.description && <p class="lede">{raw.description}</p>}
                <form class="contact-form" id={raw.formId || 'cmsForm'} method="POST" action={raw.action || '#'}>
                  <slot />
                </form>
              </div>
            </section>
          );

        case 'policyTabs':
        case 'tabs':
          return (
            <section class="block-tabs block-policy-tabs" data-block-id={blockId} style="padding:48px 0">
              <div class="wrap">
                {raw.title && <h2 class="h2">{raw.title}</h2>}
                {raw.description && <p class="lede">{raw.description}</p>}
                <div class="tabs-header" role="tablist" aria-label={raw.title || 'Policy Tabs'}>
                  {Array.isArray(raw.tabs || raw.policies) && (raw.tabs || raw.policies).map((tab: any, tIdx: number) => (
                    <button role="tab" class={`tab-btn ${tIdx === 0 ? 'active' : ''}`} id={`tab-${blockId}-${tIdx}`} aria-selected={tIdx === 0 ? 'true' : 'false'}>
                      {tab.label || tab.title}
                    </button>
                  ))}
                </div>
                {Array.isArray(raw.tabs || raw.policies) && (raw.tabs || raw.policies).map((tab: any, tIdx: number) => (
                  <div role="tabpanel" class={`tab-content ${tIdx === 0 ? 'active' : ''}`} style={tIdx === 0 ? 'margin-top:20px' : 'display:none;margin-top:20px'}>
                    {tab.content && <div set:html={tab.content} />}
                    {tab.body && <p style="color:#475467;line-height:1.6">{tab.body}</p>}
                  </div>
                ))}
              </div>
            </section>
          );

        case 'appEmbed':
          return (
            <div class={`block-app-embed app-embed-${raw.widget || 'widget'}`} data-block-id={blockId} data-widget={raw.widget}>
              <div class="wrap">
                {raw.title && <h3 class="h3">{raw.title}</h3>}
              </div>
            </div>
          );

        case 'html':
          return (
            <div class="block-html" data-block-id={blockId} set:html={raw.content || raw.html || ''} />
          );

        default:
          return (
            <div class={`block-custom block-${type}`} data-block-id={blockId} style="padding:32px 0">
              <div class="wrap">
                {raw.title && <h3 class="h3">{raw.title}</h3>}
                {raw.heading && !raw.title && <h3 class="h3">{raw.heading}</h3>}
                {raw.body && <p style="color:#475467;margin-top:8px">{raw.body}</p>}
              </div>
            </div>
          );
      }
    } catch (err) {
      console.error(`[BlockDispatcher] Rendering error for block #${idx} (${(b as any)?.type}):`, err);
      return null;
    }
  })}
</div>
