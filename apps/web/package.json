{
  "name": "@twinmos/web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "build:only": "astro build",
    "preview": "astro preview",
    "port": "python ../../tooling/port_pages.py",
    "sitemap": "python ../../tooling/gen_sitemap.py",
    "predev": "node ../../tooling/sync-prototype-assets.mjs",
    "prebuild": "node ../../tooling/sync-prototype-assets.mjs && node --experimental-strip-types --no-warnings ../../tooling/export-content.mjs || node ../../tooling/export-fallback.mjs",
    "sync:proto": "node ../../tooling/sync-prototype-assets.mjs",
    "import:corpus": "node --experimental-strip-types --no-warnings ../../tooling/import-corpus.ts",
    "export:content": "node --experimental-strip-types --no-warnings ../../tooling/export-content.mjs"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "@twinmos/shared": "0.1.0"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "lighthouse": "^12.0.0",
    "pagefind": "^1.5.2"
  }
}
