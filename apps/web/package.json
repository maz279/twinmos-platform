{
  "name": "@twinmos/web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "typecheck": "astro check",
    "build": "astro build",
    "build:only": "astro build",
    "preview": "astro preview",
    "sitemap": "node ../../tooling/gen_sitemap.mjs",
    "catalog:build": "node --experimental-strip-types --no-warnings ../../tooling/build-catalog-data.ts",
    "predev": "node ../../tooling/sync-prototype-assets.mjs && node --experimental-strip-types --no-warnings ../../tooling/build-catalog-data.ts",
    "prebuild": "node ../../tooling/sync-prototype-assets.mjs && node --experimental-strip-types --no-warnings ../../tooling/build-catalog-data.ts && node ../../tooling/gen_sitemap.mjs",
    "sync:proto": "node ../../tooling/sync-prototype-assets.mjs",
    "import:corpus": "node --experimental-strip-types --no-warnings ../../tooling/import-corpus.ts"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/node": "11.1.7",
    "@twinmos/shared": "0.1.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "lighthouse": "^12.0.0"
  }
}
