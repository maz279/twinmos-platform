{
  "name": "@twinmos/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch-path=src --watch --experimental-strip-types --no-warnings src/index.ts",
    "start": "node --env-file-if-exists=../../.env --experimental-strip-types --no-warnings src/index.ts",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=../../.env --experimental-strip-types --no-warnings scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env --experimental-strip-types --no-warnings scripts/seed.ts",
    "db:seed:bootstrap": "node --env-file-if-exists=../../.env --experimental-strip-types --no-warnings scripts/seed.ts --bootstrap",
    "db:seed:demo": "node --env-file-if-exists=../../.env --experimental-strip-types --no-warnings scripts/seed.ts --demo",
    "db:import:menus": "node --env-file-if-exists=../../.env --experimental-strip-types --no-warnings scripts/import-prototype-menus.ts",
    "db:reset": "node --env-file-if-exists=../../.env --experimental-strip-types --no-warnings scripts/reset.ts",
    "db:repair-translations": "node --env-file-if-exists=../../.env --experimental-strip-types --no-warnings scripts/repair-translations.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@twinmos/db": "0.1.0",
    "@twinmos/shared": "0.1.0",
    "better-auth": "^1.7.26",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "isomorphic-dompurify": "^4.8.0",
    "jsdom": "^31.0.1",
    "marked": "^18.2.1",
    "pino": "^10.4.0",
    "resend": "^6.39.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "otplib": "13.6.0",
    "vitest": "^5.1.1"
  }
}
