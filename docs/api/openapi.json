{
  "openapi": "3.1.0",
  "info": {
    "title": "TwinMOS Corporate Platform API",
    "version": "0.3.0",
    "description": "Production REST API specification for TwinMOS Corporate Website, CMS Admin, Partner Portal, and Delivery subsystem.",
    "contact": {
      "name": "TwinMOS Operations",
      "email": "ops@twinmos.com"
    }
  },
  "servers": [
    {
      "url": "https://www.twinmos.com/api/v1",
      "description": "Production Edge (Cloudflare AOP / Nginx)"
    },
    {
      "url": "http://127.0.0.1:8787/api/v1",
      "description": "Local Development / Upstream"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Basic Liveness Probe",
        "description": "Truthful health check verifying database ping. Returns 200 OK or 503 Service Unavailable.",
        "responses": {
          "200": {
            "description": "API and database healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/health/deep": {
      "get": {
        "summary": "Deep Component Diagnostics Probe",
        "description": "Readiness probe inspecting DB latency, outbox queue depth, active alert counts, and process uptime.",
        "responses": {
          "200": {
            "description": "All subsystems healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeepHealthStatus"
                }
              }
            }
          },
          "503": {
            "description": "Subsystem degraded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeepHealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/forms/contact": {
      "post": {
        "summary": "Submit Contact Lead",
        "description": "Rate-limited public lead submission (5 req/min/IP). Generates lead reference code and dispatches outbox event.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactFormInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Lead recorded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "refCode": { "type": "string" }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error (RFC 9457 Problem Details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/sn-check": {
      "post": {
        "summary": "Anti-Counterfeit Serial Verification",
        "description": "Verifies hardware serial number authenticity. Rate limited to 10 req/min/IP.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["serialNumber"],
                "properties": {
                  "serialNumber": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "genuine": { "type": "boolean" },
                    "model": { "type": "string" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/alerts": {
      "get": {
        "summary": "List Active Operational Alerts",
        "description": "Returns active firing alerts and telemetry metrics summary. Requires staff role (viewer or above).",
        "security": [{ "SessionAuth": [] }],
        "responses": {
          "200": {
            "description": "Active alerts list and summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertsListResponse"
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "status": { "type": "integer" },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "instance": { "type": "string" },
          "code": { "type": "string" }
        },
        "required": ["status", "title"]
      },
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ok", "degraded"] },
          "service": { "type": "string" },
          "version": { "type": "string" },
          "db": { "type": "string" }
        },
        "required": ["status", "service", "version", "db"]
      },
      "DeepHealthStatus": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ok", "degraded"] },
          "service": { "type": "string" },
          "version": { "type": "string" },
          "uptimeSec": { "type": "number" },
          "timestamp": { "type": "string", "format": "date-time" },
          "components": {
            "type": "object",
            "properties": {
              "database": {
                "type": "object",
                "properties": {
                  "status": { "type": "string" },
                  "latencyMs": { "type": "number" }
                }
              },
              "outbox": {
                "type": "object",
                "properties": {
                  "status": { "type": "string" },
                  "pendingCount": { "type": "number" }
                }
              },
              "alerts": {
                "type": "object",
                "properties": {
                  "firingCount": { "type": "number" }
                }
              }
            }
          }
        }
      },
      "ContactFormInput": {
        "type": "object",
        "required": ["name", "email", "message", "subject"],
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "email": { "type": "string", "format": "email" },
          "subject": { "type": "string" },
          "message": { "type": "string", "minLength": 10 },
          "cfTurnstile": { "type": "string" }
        }
      },
      "AlertsListResponse": {
        "type": "object",
        "properties": {
          "alerts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "ruleId": { "type": "string" },
                "severity": { "type": "string" },
                "title": { "type": "string" },
                "message": { "type": "string" },
                "timestamp": { "type": "string" }
              }
            }
          },
          "summary": { "type": "object" }
        }
      }
    },
    "securitySchemes": {
      "SessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token"
      }
    }
  }
}
