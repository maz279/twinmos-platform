{
  "name": "twinmos-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,admin,web -c blue,magenta,cyan \"npm:dev:api\" \"npm:dev:admin\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @twinmos/api",
    "dev:admin": "npm run dev --workspace @twinmos/admin",
    "dev:web": "npm run dev --workspace @twinmos/web",
    "db:generate": "npm run generate --workspace @twinmos/db",
    "db:migrate": "npm run db:migrate --workspace @twinmos/api",
    "db:seed": "npm run db:seed --workspace @twinmos/api",
    "db:seed:bootstrap": "npm run db:seed:bootstrap --workspace @twinmos/api",
    "db:seed:demo": "npm run db:seed:demo --workspace @twinmos/api",
    "db:import:menus": "npm run db:import:menus --workspace @twinmos/api",
    "seed:demo": "npm run db:seed:demo --workspace @twinmos/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -p apps/api/tsconfig.json && tsc -p apps/admin/tsconfig.json && tsc -p packages/db/tsconfig.json && tsc -p packages/shared/tsconfig.json && npm run typecheck --workspace @twinmos/web",
    "test:ci": "npm run build -w @twinmos/web && npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "verify:gate-a": "node tooling/verify/run-all-gate-a.mjs",
    "verify:gate-b": "node tooling/verify/run-all-gate-b.mjs",
    "verify:vc-b": "node tooling/verify/verify-vc-b-audit.mjs",
    "verify:gate-c": "node tooling/verify/run-all-gate-c.mjs",
    "verify:ms34": "node tooling/verify/verify-ms34-audit.mjs",
    "verify:ms35": "node tooling/verify/verify-ms35-audit.mjs",
    "verify:ms36": "node tooling/verify/verify-ms36-audit.mjs",
    "verify:ms37": "node tooling/verify/verify-ms37-audit.mjs",
    "verify:ms42": "node tooling/verify/verify-ms42-audit.mjs",
    "verify:ms44": "node --experimental-strip-types --no-warnings tooling/verify/verify-ms44-audit.mjs",
    "verify:ms44:parity": "node tooling/verify/verify-ms44-parity.mjs",
    "verify:deploy": "node tooling/verify/verify-rollback.mjs",
    "verify:qj": "node tooling/verify/verify-quality-jobs.mjs",
    "verify:manual": "node tooling/verify/manual-test-suite.mjs",
    "verify:visual": "node tooling/verify/visual-a11y-audit.mjs",
    "verify:greflect": "node tooling/verify/greflect-fixture.mjs",
    "verify:gparity": "node tooling/verify/gparity-harness.mjs",
    "verify:catalog-drift": "node tooling/verify/verify-catalog-drift.mjs --expect-live",
    "lint": "npm run lint --workspace @twinmos/admin",
    "format:check": "npx prettier --check package.json tooling/verify/greflect-fixture.mjs tooling/verify/gparity-harness.mjs",
    "format": "npx prettier --write package.json tooling/verify/greflect-fixture.mjs tooling/verify/gparity-harness.mjs",
    "pre-commit": "node tooling/verify/pre-commit-check.mjs",
    "verify:vc-c": "node tooling/verify/verify-vc-c-audit.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
