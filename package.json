{
  "name": "twinmos-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,admin,web -c blue,magenta,cyan \"npm:dev:api\" \"npm:dev:admin\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @twinmos/api",
    "dev:admin": "npm run dev --workspace @twinmos/admin",
    "dev:web": "npm run dev --workspace @twinmos/web",
    "db:generate": "npm run generate --workspace @twinmos/db",
    "db:migrate": "npm run db:migrate --workspace @twinmos/api",
    "db:seed": "npm run db:seed --workspace @twinmos/api",
    "content:export": "node --experimental-strip-types --no-warnings tooling/export-content.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -p apps/api/tsconfig.json && tsc -p apps/admin/tsconfig.json && tsc -p packages/db/tsconfig.json && tsc -p packages/shared/tsconfig.json",
    "test:ci": "npm run build -w @twinmos/web && npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
