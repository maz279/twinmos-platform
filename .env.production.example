# TwinMOS API — PRODUCTION environment template (P7).
# Copy to apps/api/.env (or the systemd Environment= block) and fill EVERY value.
# Credentials come ONLY from the secret store / environment — never commit filled copies.

# --- Required ---
NODE_ENV=production
PORT=8787
# Real Postgres 16 (the API refuses to boot on PGlite in production)
DATABASE_URL=postgres://USER:PASS@HOST:5432/twinmos
# Public HTTPS origin — Better Auth derives Secure cookies from this
BETTER_AUTH_URL=https://www.twinmos.com
BETTER_AUTH_SECRET=__from_secret_store__
# Same-origin in production; only cross-origin surfaces if any remain
ALLOWED_ORIGIN=https://www.twinmos.com
# Behind Cloudflare/nginx: REQUIRED so forwarded headers (cf-connecting-ip) are
# trusted for rate limiting. WITHOUT it, production uses raw socket addresses
# and every proxied request shares the proxy's bucket.
TRUST_PROXY=1

# --- Mail (required in production; dev falls back to the outbox driver) ---
RESEND_API_KEY=__from_secret_store__
MAIL_FROM=no-reply@twinmos.com
FORMS_TO=support@twinmos.com
# Per-type overrides as needed: RMA_TO, JOB_APPLICATION_TO, QUOTE_TO, ...

# --- Anti-spam (REQUIRED in production — never set the bypass) ---
TURNSTILE_SECRET_KEY=__from_secret_store__

# --- NEVER in production (dev-only conveniences; the API hard-refuses these
#     under NODE_ENV=production regardless, keep them unset anyway) ---
# API_ALLOW_NO_TURNSTILE=1   # bypasses form captcha — DEV/TEST ONLY
# API_DEV_AUTOLOGIN=1        # POST /api/v1/dev/session opens a staff session —
#                            # DEV ONLY, triple-guarded (flag + NODE_ENV + env password)

# --- Web BUILD-time vars (set on the machine running the web build; baked into
#     the static HTML — NOT API runtime vars) ---
# PUBLIC_TURNSTILE_SITE_KEY=__site_key__     # renders the Turnstile widget on all public forms
# PUBLIC_API_URL: LEAVE UNSET in production. Empty (the fresh-clone default) makes
#   forms.js call same-origin /api/v1 behind nginx — correct. Setting "/api/v1" via
#   Git Bash assignment MSYS-mangles it to a Windows path; unset is both safe and right.

# --- Uploads ---
PARTNER_FILES_DIR=/var/lib/twinmos/partner-files
MEDIA_DIR=/var/lib/twinmos/media
# MEDIA_MAX_BYTES=10485760
# PARTNER_MAX_BYTES=26214400

# --- Optional tuning ---
# AUDIT_RETENTION_DAYS=365        # docs/02: 12-month audit retention
# AUDIT_RETENTION_DISABLED=1      # only for one-off diagnostics
