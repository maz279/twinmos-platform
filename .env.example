# --- API service (apps/api) ---
PORT=8787
BETTER_AUTH_URL=http://127.0.0.1:8787   # production: https://www.twinmos.com
# Cross-origin dev surfaces trusted for auth (admin Vite, web preview); production is same-origin
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4321
# Dev-only conveniences (NEVER set in production):
API_ALLOW_NO_TURNSTILE=1
# Seeded first admin (dev default password lives in scripts/seed.ts — override before staging)
SEED_ADMIN_EMAIL=admin@twinmos.dev
# SEED_ADMIN_PASSWORD=change-me-min-10-chars

# --- Form routing + transactional mail (P2) ---
# Recipients are env-only; per-type override: <TYPE>_TO beats FORMS_TO (e.g. RMA_TO, JOB_APPLICATION_TO)
# FORMS_TO=support@twinmos.dev
# MAIL_OUTBOX_DIR=./data/outbox      # dev driver writes JSON here when RESEND_API_KEY is unset

# --- Upload caps (P3 media / P5 partner assets) ---
# MEDIA_MAX_BYTES=10485760           # media library per-file cap (default 10 MB)
# PARTNER_MAX_BYTES=26214400         # partner price/MDF/resource file cap (default 25 MB;
#                                    # document types only: pdf xlsx xls csv docx doc pptx zip png jpg jpeg)
# PARTNER_FILES_DIR=./data/partner-files

# --- Production-only ---
# DATABASE_URL=postgres://user:pass@host:5432/twinmos      # required when NODE_ENV=production
# ALLOWED_ORIGIN=https://www.twinmos.com                   # CORS (comma-separated)
# TURNSTILE_SECRET_KEY=...
# TURNSTILE_SITE_KEY=...                                   # public key, also baked into the web build
# RESEND_API_KEY=...
# MAIL_FROM=no-reply@twinmos.com

# --- Web (apps/web) ---
# PUBLIC_API_URL=/api/v1                                   # '' / unset → same-origin reverse proxy (production);
#                                                          # cross-origin dev: http://127.0.0.1:8787/api/v1

# --- Dev database (packages/db) ---
# PGLITE_DATA=./data/dev.pgdata
